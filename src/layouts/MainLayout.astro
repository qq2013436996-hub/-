---
// src/layouts/MainLayout.astro
import {sanityClient} from 'sanity:client'
import {assignCategoryPathSlugs} from '../lib/slugify'

interface Props {
  title?: string
  description?: string
  seo?: {
    metaTitle?: string | null
    metaDescription?: string | null
    canonicalUrl?: string | null
    ogTitle?: string | null
    ogDescription?: string | null
    ogImage?: string | null
    robots?: string | null
    jsonLd?: Record<string, unknown> | Array<Record<string, unknown>> | null
  }
}

const settings = await sanityClient.fetch<{
  companyName: string | null
  companyDescription: string | null
  logoUrl: string | null
  primaryColor: string | null
  contactEmail: string | null
  contactPhone: string | null
  footerText: string | null
  seo: {
    metaTitle: string | null
    metaDescription: string | null
    canonicalUrl: string | null
    ogTitle: string | null
    ogDescription: string | null
    ogImageUrl: string | null
    robots: string | null
  } | null
} | null>(`*[_type == "siteSettings"][0]{
  companyName,
  companyDescription,
  "logoUrl": coalesce(logo.image.asset->url, logo.asset->url),
  primaryColor,
  contactEmail,
  contactPhone,
  footerText,
  "seo": coalesce(defaultSeo, seo){
    metaTitle,
    metaDescription,
    canonicalUrl,
    ogTitle,
    ogDescription,
    "ogImageUrl": ogImage.asset->url,
    robots
  }
}`)

const hexOk = (v: string | null | undefined) =>
  typeof v === 'string' && /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/.test(v.trim())

const themeColor = hexOk(settings?.primaryColor) ? settings!.primaryColor!.trim() : '#ff6600'

const displayName = settings?.companyName?.trim() || 'Car Light'
const baseSiteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.url.origin || 'http://localhost:4321').replace(
  /\/$/,
  '',
)

const defaultPageTitle = `${displayName} | B2B LED Solutions`
const {title, description, seo} = Astro.props as Props
const mergedTitle = seo?.metaTitle?.trim() || title || settings?.seo?.metaTitle?.trim() || defaultPageTitle

const defaultDescription =
  settings?.companyDescription?.trim() ||
  'Professional manufacturer of high-performance LED working lights for agricultural, construction, and mining vehicles.'
const mergedDescription =
  seo?.metaDescription?.trim() || description || settings?.seo?.metaDescription?.trim() || defaultDescription
const canonicalInput =
  seo?.canonicalUrl?.trim() ||
  settings?.seo?.canonicalUrl?.trim() ||
  `${baseSiteUrl}${Astro.url.pathname}${Astro.url.search}`
const canonicalHref = canonicalInput.startsWith('http') ? canonicalInput : `${baseSiteUrl}${canonicalInput}`
const ogTitle = seo?.ogTitle?.trim() || settings?.seo?.ogTitle?.trim() || mergedTitle
const ogDescription = seo?.ogDescription?.trim() || settings?.seo?.ogDescription?.trim() || mergedDescription
const ogImage = seo?.ogImage?.trim() || settings?.seo?.ogImageUrl?.trim() || settings?.logoUrl || null
const jsonLdItems = Array.isArray(seo?.jsonLd) ? seo?.jsonLd : seo?.jsonLd ? [seo.jsonLd] : []

const footerBlurb =
  settings?.companyDescription?.trim() ||
  'Professional manufacturer of high-performance LED working lights for agricultural, construction, and mining vehicles.'

const footerEmail = settings?.contactEmail?.trim() || 'info@example.com'
const footerPhone = settings?.contactPhone?.trim() || ''

type FooterCategoryRow = {
  _id: string
  title: string | null
  slug: string | null
}

const footerCategoryRows = await sanityClient.fetch<FooterCategoryRow[]>(
  `*[_type == "productCategory"] | order(title asc)[0...6] {
    _id,
    title,
    "slug": slug.current
  }`,
)

const footerProductLinks = assignCategoryPathSlugs(footerCategoryRows ?? [])
  .filter((r) => Boolean(r.title && r.pathSlug))
  .slice(0, 4)

const drawerCategoryLinks = assignCategoryPathSlugs(footerCategoryRows ?? [])
  .filter((r) => Boolean(r.title && r.pathSlug))
  .slice(0, 10)

type NavAppRow = {title: string | null; slug: string | null}
const navApplicationRows = await sanityClient.fetch<NavAppRow[]>(
  `*[_type == "application" && defined(slug.current)] | order(title asc)[0...8]{
    title,
    "slug": slug.current
  }`,
)
const navApplicationLinks = (navApplicationRows ?? []).filter(
  (r): r is NavAppRow & {slug: string; title: string} => Boolean(r.slug && r.title),
)
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{mergedTitle}</title>
    <meta name="description" content={mergedDescription} />
    <link rel="canonical" href={canonicalHref} />
    <!-- 暴力排查：整站固定 robots，验证是否仍被 PageSpeed 判为屏蔽收录 -->
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={displayName} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalHref} />
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {ogImage ? <meta name="twitter:image" content={ogImage} /> : null}
    {
      jsonLdItems.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600&display=swap"
      rel="stylesheet"
    />
    <style
      is:global
      define:vars={{
        themeColor,
      }}
    >
      :root {
        --primary-color: var(--themeColor);
        --text-main: #14110f;
        --text-muted: #5a534c;
        --bg-light: #ebe6df;
        --border-color: rgba(20, 17, 15, 0.12);
        --coral-cta: #f07179;
        --page-bg: #f4f1ec;
      }

      .btn-coral-solid {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 28px;
        box-sizing: border-box;
        background: var(--coral-cta);
        color: #fff !important;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        border-radius: 3px;
        border: none;
        box-shadow: 0 1px 0 rgba(15, 23, 42, 0.06);
        transition:
          filter 0.18s ease,
          transform 0.18s ease;
      }

      .btn-coral-solid:hover {
        filter: brightness(0.94);
      }

      .btn-coral-solid:active {
        transform: translateY(1px);
      }

      body.lux-theme {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .site-content {
        flex-grow: 1;
      }
    </style>
  </head>
  <body class="lux-theme">
    <div class="lux-announce">
      OEM / ODM · Global shipping · Sampling &amp; compliance support · Reply within 24 hours
    </div>

    <header class="lux-topbar">
      <div class="lux-topbar-inner">
        <button
          type="button"
          id="lux-menu-btn"
          class="lux-menu-btn"
          aria-expanded="false"
          aria-controls="lux-drawer-panel"
        >
          <span class="lux-menu-icon" aria-hidden="true">
            <span class="lux-menu-mid"></span>
          </span>
          <span class="lux-menu-label">Menu</span>
        </button>

        <a href="/" class="lux-topbar-logo">
          {
            settings?.logoUrl ? (
              <img src={settings.logoUrl} alt={displayName} width="180" height="40" loading="eager" />
            ) : (
              <span class="lux-topbar-logo-text">{displayName}</span>
            )
          }
        </a>

        <div class="lux-topbar-actions">
          <a href="/contact" class="lux-topbar-link">Contact</a>
          <a href="/request-quote" class="lux-topbar-cta">Request quote</a>
        </div>
      </div>
    </header>

    <div id="lux-drawer" class="lux-drawer" aria-hidden="true">
      <div class="lux-drawer-backdrop" id="lux-drawer-backdrop" tabindex="-1"></div>
      <div
        id="lux-drawer-panel"
        class="lux-drawer-panel"
        role="dialog"
        aria-modal="true"
        aria-label="Site navigation"
        inert
      >
        <button type="button" id="lux-drawer-close" class="lux-drawer-close" aria-label="Close menu">
          ×
        </button>

        <div class="lux-drawer-menu">
          <div class="lux-drawer-frame">
            <div class="lux-drawer-rows">
              <div class="lux-drawer-row">
                <a class="lux-major" href="/products">
                  <span class="lux-major-n">01</span>
                  <span class="t">The products</span>
                </a>
                <ul class="lux-subs">
                  <li><a href="/products">All products</a></li>
                  {
                    drawerCategoryLinks.length ? (
                      drawerCategoryLinks.map((item) => (
                        <li>
                          <a href={`/category/${item.pathSlug}`}>{item.title}</a>
                        </li>
                      ))
                    ) : (
                      <>
                        <li><a href="/products">Browse catalogue</a></li>
                        <li><a href="/request-quote">Request a quote</a></li>
                      </>
                    )
                  }
                </ul>
              </div>

              <div class="lux-drawer-row">
                <a class="lux-major" href="/applications">
                  <span class="lux-major-n">02</span>
                  <span class="t">Applications</span>
                </a>
                <ul class="lux-subs">
                  <li><a href="/applications">All applications</a></li>
                  {
                    navApplicationLinks.length ? (
                      navApplicationLinks.map((item) => (
                        <li>
                          <a href={`/applications/${item.slug}`}>{item.title}</a>
                        </li>
                      ))
                    ) : (
                      <li><a href="/applications">Browse scenarios</a></li>
                    )
                  }
                </ul>
              </div>

              <div class="lux-drawer-row">
                <a class="lux-major" href="/introduction">
                  <span class="lux-major-n">03</span>
                  <span class="t">Company</span>
                </a>
                <ul class="lux-subs">
                  <li><a href="/introduction">About us</a></li>
                  <li><a href="/contact">Contact</a></li>
                  <li><a href="/request-quote">Request quote</a></li>
                </ul>
              </div>

              <div class="lux-drawer-row">
                <a class="lux-major" href="/blog">
                  <span class="lux-major-n">04</span>
                  <span class="t">Resources</span>
                </a>
                <ul class="lux-subs">
                  <li><a href="/case-studies">Shows &amp; events</a></li>
                  <li><a href="/faqs">Help center</a></li>
                  <li><a href="/blog">Blog</a></li>
                  <li><a href="/video">Video</a></li>
                </ul>
              </div>
            </div>

            <div class="lux-drawer-foot">
              <a href="/faqs">FAQ</a>
              <span aria-hidden="true">·</span>
              <a href="/contact">Contact us</a>
              <span class="lux-drawer-lang">EN / 中文</span>
            </div>
          </div>
        </div>

        <div class="lux-drawer-visual" aria-hidden="true">
          <img src="/home/hero-banner.png" alt="" width="800" height="1200" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>

    <div class="site-content">
      <slot />
    </div>

    <footer class="lux-site-footer">
      <section class="lux-footer-cta">
        <h2>Ready to work with us?</h2>
        <p>
          Whether you need a standard product or a customized OEM solution, our team is ready to support your
          next project.
        </p>
        <div class="lux-footer-actions">
          <a href="/request-quote" class="lux-footer-btn lux-footer-btn--solid">Contact our team</a>
          <a href="/products" class="lux-footer-btn lux-footer-btn--ghost">Browse products</a>
        </div>
        <div class="lux-footer-tags">
          <span>OEM / ODM</span>
          <span>Global shipping</span>
          <span>Sampling</span>
          <span>Reply within 24 hours</span>
        </div>
      </section>
      <div class="lux-footer-grid">
        <div>
          <h3 class="lux-footer-title">{displayName}</h3>
          <p>{footerBlurb}</p>
        </div>
        <div>
          <h3 class="lux-footer-title">Products</h3>
          <a href="/products">All products</a>
          {
            footerProductLinks.length ? (
              footerProductLinks.map((item) => <a href={`/category/${item.pathSlug}`}>{item.title}</a>)
            ) : (
              <>
                <a href="/products">Catalogue</a>
                <a href="/request-quote">Get a quote</a>
              </>
            )
          }
        </div>
        <div>
          <h3 class="lux-footer-title">Company</h3>
          <a href="/introduction">About us</a>
          <a href="/blog">Blog</a>
          <a href="/faqs">Help center</a>
          <a href="/video">Video</a>
          <a href="/applications">Applications</a>
          <a href="/case-studies">Shows &amp; events</a>
          <a href="/contact">Contact us</a>
        </div>
        <div>
          <h3 class="lux-footer-title">Contact</h3>
          <p>
            <a href={`mailto:${footerEmail}`}>{footerEmail}</a>
          </p>
          {
            footerPhone ? (
              <p>
                <a href={`tel:${footerPhone.replace(/\s/g, '')}`}>{footerPhone}</a>
              </p>
            ) : (
              <p>Phone: —</p>
            )
          }
        </div>
      </div>
      <div class="lux-footer-bottom">
        <p>
          {
            settings?.footerText?.trim() ||
              `© ${new Date().getFullYear()} ${displayName}. All rights reserved.`
          }
        </p>
      </div>
    </footer>

    <link rel="stylesheet" href="/lux-theme.css" />

    <script is:inline>
      (function () {
        var drawer = document.getElementById('lux-drawer')
        var panel = document.getElementById('lux-drawer-panel')
        var btn = document.getElementById('lux-menu-btn')
        var closeBtn = document.getElementById('lux-drawer-close')
        var backdrop = document.getElementById('lux-drawer-backdrop')
        if (!drawer || !panel || !btn || !closeBtn) return

        var lastFocus = null

        function setOpen(open) {
          drawer.classList.toggle('is-open', open)
          drawer.setAttribute('aria-hidden', open ? 'false' : 'true')
          btn.setAttribute('aria-expanded', open ? 'true' : 'false')
          if (open) {
            lastFocus = document.activeElement
            document.body.style.overflow = 'hidden'
            panel.removeAttribute('inert')
            window.setTimeout(function () {
              closeBtn.focus()
            }, 60)
          } else {
            document.body.style.overflow = ''
            panel.setAttribute('inert', '')
            if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus()
          }
        }

        function openDrawer() {
          setOpen(true)
        }
        function closeDrawer() {
          setOpen(false)
        }

        btn.addEventListener('click', function () {
          if (drawer.classList.contains('is-open')) closeDrawer()
          else openDrawer()
        })
        closeBtn.addEventListener('click', closeDrawer)
        if (backdrop) backdrop.addEventListener('click', closeDrawer)

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer()
        })
      })()
    </script>
  </body>
</html>
