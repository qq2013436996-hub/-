---
import MainLayout from '../../layouts/MainLayout.astro'
import BlogListing from '../../components/BlogListing.astro'
import {BLOG_PAGE_SIZE, fetchBlogPosts} from '../../lib/blogPosts'

const all = await fetchBlogPosts()
const totalPages = Math.max(1, Math.ceil(all.length / BLOG_PAGE_SIZE))
const posts = all.slice(0, BLOG_PAGE_SIZE)
const currentPage = 1
---

<MainLayout
  title="Blog | bike"
  description="Read insights, guides, and project updates from bike."
  seo={{canonicalUrl: '/blog/'}}
>
  <main class="blog-page">
    <section class="blog-hero">
      <div class="blog-hero-inner">
        <h1>Blog</h1>
      </div>
    </section>

    <div class="container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>&gt;&gt;</span>
        <span>Blog</span>
      </nav>

      {all.length ? (
        <BlogListing posts={posts} currentPage={currentPage} totalPages={totalPages} />
      ) : (
        <p class="empty">No blog posts yet. Add and publish `blogPost` documents in Sanity Studio.</p>
      )}
    </div>
  </main>
</MainLayout>

<style>
  .blog-page {
    background: var(--page-bg);
  }

  .blog-hero {
    min-height: clamp(180px, 24vw, 290px);
    background:
      linear-gradient(rgba(32, 25, 21, 0.45), rgba(32, 25, 21, 0.45)),
      url('/contact/hero-candles.png') center / cover no-repeat;
    display: flex;
    align-items: center;
  }

  .blog-hero-inner {
    width: min(1140px, 100%);
    margin: 0 auto;
    padding: 0 20px;
  }

  .blog-hero h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 12px 20px 60px;
  }

  .crumb {
    margin: 0 0 22px;
    font-size: 0.82rem;
    color: #e85d6f;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .crumb a {
    color: #e85d6f;
    text-decoration: none;
  }

  .crumb a:hover {
    text-decoration: underline;
  }

  .empty {
    color: #64748b;
    line-height: 1.8;
    margin: 18px 0;
  }
</style>
