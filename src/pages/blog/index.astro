---
import {sanityClient} from 'sanity:client'
import MainLayout from '../../layouts/MainLayout.astro'

type BlogRow = {
  title: string | null
  slug: string | null
  excerpt: string | null
  publishedAt: string | null
  imageUrl: string | null
  imageAlt: string | null
}

const rows = await sanityClient.fetch<BlogRow[]>(
  `*[_type == "blogPost" && defined(slug.current)] | order(coalesce(publishedAt, _createdAt) desc){
    title,
    "slug": slug.current,
    excerpt,
    publishedAt,
    "imageUrl": coalesce(featuredImage.image.asset->url, coverImage.asset->url),
    "imageAlt": coalesce(featuredImage.alt, coverImage.alt)
  }`,
)

const items = (rows ?? []).filter((row): row is BlogRow & {slug: string} => Boolean(row.slug))
const featured = items.slice(0, 4)
const rest = items.slice(4)
---

<MainLayout
  title="Blog | bike"
  description="Read insights, guides, and project updates from bike."
  seo={{canonicalUrl: '/blog/'}}
>
  <main class="blog-page">
    <section class="blog-hero">
      <div class="blog-hero-inner">
        <h1>Blog</h1>
      </div>
    </section>

    <div class="container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>&gt;&gt;</span>
        <span>Blog</span>
      </nav>

      {items.length ? (
        <>
          <section class="featured-grid" aria-label="Featured blog posts">
            {featured[0] ? (
              <a class="tile tile-main" href={`/blog/${featured[0].slug}`}>
                {featured[0].imageUrl ? (
                  <img src={featured[0].imageUrl} alt={featured[0].imageAlt ?? featured[0].title ?? 'Blog cover'} loading="eager" />
                ) : null}
                <div class="overlay">
                  <h2>{featured[0].title}</h2>
                  {featured[0].excerpt ? <p>{featured[0].excerpt}</p> : null}
                </div>
              </a>
            ) : null}

            {featured[1] ? (
              <a class="tile tile-tall" href={`/blog/${featured[1].slug}`}>
                {featured[1].imageUrl ? (
                  <img src={featured[1].imageUrl} alt={featured[1].imageAlt ?? featured[1].title ?? 'Blog cover'} loading="eager" />
                ) : null}
                <div class="overlay">
                  <h2>{featured[1].title}</h2>
                  {featured[1].excerpt ? <p>{featured[1].excerpt}</p> : null}
                </div>
              </a>
            ) : null}

            {featured[2] ? (
              <a class="tile tile-small-left" href={`/blog/${featured[2].slug}`}>
                {featured[2].imageUrl ? (
                  <img src={featured[2].imageUrl} alt={featured[2].imageAlt ?? featured[2].title ?? 'Blog cover'} loading="lazy" />
                ) : null}
                <div class="overlay">
                  <h2>{featured[2].title}</h2>
                  {featured[2].excerpt ? <p>{featured[2].excerpt}</p> : null}
                </div>
              </a>
            ) : null}

            {featured[3] ? (
              <a class="tile tile-small-right" href={`/blog/${featured[3].slug}`}>
                {featured[3].imageUrl ? (
                  <img src={featured[3].imageUrl} alt={featured[3].imageAlt ?? featured[3].title ?? 'Blog cover'} loading="lazy" />
                ) : null}
                <div class="overlay">
                  <h2>{featured[3].title}</h2>
                  {featured[3].excerpt ? <p>{featured[3].excerpt}</p> : null}
                </div>
              </a>
            ) : null}
          </section>

          {rest.length ? (
            <section class="rest-grid" aria-label="More blog posts">
              {rest.map((item) => (
                <a class="rest-card" href={`/blog/${item.slug}`}>
                  {item.imageUrl ? <img src={item.imageUrl} alt={item.imageAlt ?? item.title ?? 'Blog cover'} loading="lazy" /> : null}
                  <h3>{item.title}</h3>
                  {item.publishedAt ? <p class="meta">{new Date(item.publishedAt).toLocaleDateString()}</p> : null}
                </a>
              ))}
            </section>
          ) : null}
        </>
      ) : (
        <p class="empty">No blog posts yet. Add and publish `blogPost` documents in Sanity Studio.</p>
      )}
    </div>
  </main>
</MainLayout>

<style>
  .blog-page {
    background: #fff;
  }

  .blog-hero {
    min-height: clamp(180px, 24vw, 290px);
    background:
      linear-gradient(rgba(32, 25, 21, 0.45), rgba(32, 25, 21, 0.45)),
      url('/contact/hero-candles.png') center / cover no-repeat;
    display: flex;
    align-items: center;
  }

  .blog-hero-inner {
    width: min(1140px, 100%);
    margin: 0 auto;
    padding: 0 20px;
  }

  .blog-hero h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 12px 20px 60px;
  }

  .crumb {
    margin: 0 0 22px;
    font-size: 0.82rem;
    color: #e85d6f;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .crumb a {
    color: #e85d6f;
    text-decoration: none;
  }

  .crumb a:hover {
    text-decoration: underline;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: minmax(220px, 260px) minmax(170px, 200px);
    gap: 12px;
    margin-bottom: 26px;
  }

  .tile {
    position: relative;
    display: block;
    text-decoration: none;
    color: #fff;
    border-radius: 2px;
    overflow: hidden;
    background: #f1f5f9;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.65));
  }

  .tile:hover img {
    transform: scale(1.04);
  }

  .tile-main {
    grid-column: 1 / span 2;
    grid-row: 1;
  }

  .tile-tall {
    grid-column: 3;
    grid-row: 1 / span 2;
  }

  .tile-small-left {
    grid-column: 1;
    grid-row: 2;
  }

  .tile-small-right {
    grid-column: 2;
    grid-row: 2;
  }

  .overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 16px 14px 12px;
  }

  .overlay h2 {
    margin: 0 0 6px;
    font-size: 1.55rem;
    line-height: 1.18;
    font-weight: 700;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  .tile-small-left .overlay h2,
  .tile-small-right .overlay h2,
  .tile-tall .overlay h2 {
    font-size: 1.05rem;
  }

  .overlay p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 14px;
  }

  .rest-card {
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: #fff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .rest-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(15, 23, 42, 0.1);
  }

  .rest-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    display: block;
    border-bottom: 1px solid #e5e7eb;
  }

  .rest-card h3 {
    margin: 10px 12px 6px;
    font-size: 1rem;
    line-height: 1.35;
  }

  .rest-card .meta {
    margin: 0 12px 12px;
    color: #64748b;
    font-size: 0.84rem;
    font-weight: 600;
  }

  .empty {
    color: #64748b;
    line-height: 1.8;
    margin: 18px 0;
  }

  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 220px 180px 180px;
    }

    .tile-main {
      grid-column: 1 / span 2;
      grid-row: 1;
    }

    .tile-tall {
      grid-column: 2;
      grid-row: 2 / span 2;
    }

    .tile-small-left {
      grid-column: 1;
      grid-row: 2;
    }

    .tile-small-right {
      grid-column: 1;
      grid-row: 3;
    }

    .overlay h2 {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 640px) {
    .featured-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(4, 210px);
    }

    .tile-main,
    .tile-tall,
    .tile-small-left,
    .tile-small-right {
      grid-column: auto;
      grid-row: auto;
    }

    .overlay h2 {
      font-size: 1.05rem;
    }
  }
</style>
