---
import {sanityClient} from 'sanity:client'
import MainLayout from '../../layouts/MainLayout.astro'

type BlogRow = {
  title: string | null
  slug: string | null
  excerpt: string | null
  publishedAt: string | null
  imageUrl: string | null
  imageAlt: string | null
}

const rows = await sanityClient.fetch<BlogRow[]>(
  `*[_type == "blogPost" && defined(slug.current)] | order(coalesce(publishedAt, _createdAt) desc){
    title,
    "slug": slug.current,
    excerpt,
    publishedAt,
    "imageUrl": coalesce(featuredImage.image.asset->url, coverImage.asset->url),
    "imageAlt": coalesce(featuredImage.alt, coverImage.alt)
  }`,
)

const items = (rows ?? []).filter((row): row is BlogRow & {slug: string} => Boolean(row.slug))
const pageSize = 4
const pageChunks = Array.from({length: Math.ceil(items.length / pageSize)}, (_, i) =>
  items.slice(i * pageSize, (i + 1) * pageSize),
)
---

<MainLayout
  title="Blog | bike"
  description="Read insights, guides, and project updates from bike."
  seo={{canonicalUrl: '/blog/'}}
>
  <main class="blog-page">
    <section class="blog-hero">
      <div class="blog-hero-inner">
        <h1>Blog</h1>
      </div>
    </section>

    <div class="container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>&gt;&gt;</span>
        <span>Blog</span>
      </nav>

      {items.length ? (
        <>
          {pageChunks.map((chunk, pageIdx) => (
            <section class={`featured-grid page-grid ${pageIdx === 0 ? 'active' : ''}`} data-page={pageIdx + 1} aria-label={`Blog page ${pageIdx + 1}`}>
              {chunk[0] ? (
                <a class="tile tile-main" href={`/blog/${chunk[0].slug}`}>
                  {chunk[0].imageUrl ? (
                    <img src={chunk[0].imageUrl} alt={chunk[0].imageAlt ?? chunk[0].title ?? 'Blog cover'} loading={pageIdx === 0 ? 'eager' : 'lazy'} />
                  ) : null}
                  <div class="overlay">
                    <h2>{chunk[0].title}</h2>
                    {chunk[0].excerpt ? <p>{chunk[0].excerpt}</p> : null}
                  </div>
                </a>
              ) : null}

              {chunk[1] ? (
                <a class="tile tile-tall" href={`/blog/${chunk[1].slug}`}>
                  {chunk[1].imageUrl ? (
                    <img src={chunk[1].imageUrl} alt={chunk[1].imageAlt ?? chunk[1].title ?? 'Blog cover'} loading="lazy" />
                  ) : null}
                  <div class="overlay">
                    <h2>{chunk[1].title}</h2>
                    {chunk[1].excerpt ? <p>{chunk[1].excerpt}</p> : null}
                  </div>
                </a>
              ) : null}

              {chunk[2] ? (
                <a class="tile tile-small-left" href={`/blog/${chunk[2].slug}`}>
                  {chunk[2].imageUrl ? (
                    <img src={chunk[2].imageUrl} alt={chunk[2].imageAlt ?? chunk[2].title ?? 'Blog cover'} loading="lazy" />
                  ) : null}
                  <div class="overlay">
                    <h2>{chunk[2].title}</h2>
                    {chunk[2].excerpt ? <p>{chunk[2].excerpt}</p> : null}
                  </div>
                </a>
              ) : null}

              {chunk[3] ? (
                <a class="tile tile-small-right" href={`/blog/${chunk[3].slug}`}>
                  {chunk[3].imageUrl ? (
                    <img src={chunk[3].imageUrl} alt={chunk[3].imageAlt ?? chunk[3].title ?? 'Blog cover'} loading="lazy" />
                  ) : null}
                  <div class="overlay">
                    <h2>{chunk[3].title}</h2>
                    {chunk[3].excerpt ? <p>{chunk[3].excerpt}</p> : null}
                  </div>
                </a>
              ) : null}
            </section>
          ))}

          {pageChunks.length > 1 ? (
            <nav class="pager" aria-label="Blog pagination">
              {pageChunks.map((_, idx) => (
                <button class={`pager-btn ${idx === 0 ? 'active' : ''}`} data-page-btn={idx + 1} type="button">
                  {idx + 1}
                </button>
              ))}
            </nav>
          ) : null}
        </>
      ) : (
        <p class="empty">No blog posts yet. Add and publish `blogPost` documents in Sanity Studio.</p>
      )}
    </div>
  </main>
</MainLayout>

<style>
  .blog-page {
    background: #fff;
  }

  .blog-hero {
    min-height: clamp(180px, 24vw, 290px);
    background:
      linear-gradient(rgba(32, 25, 21, 0.45), rgba(32, 25, 21, 0.45)),
      url('/contact/hero-candles.png') center / cover no-repeat;
    display: flex;
    align-items: center;
  }

  .blog-hero-inner {
    width: min(1140px, 100%);
    margin: 0 auto;
    padding: 0 20px;
  }

  .blog-hero h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 12px 20px 60px;
  }

  .crumb {
    margin: 0 0 22px;
    font-size: 0.82rem;
    color: #e85d6f;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .crumb a {
    color: #e85d6f;
    text-decoration: none;
  }

  .crumb a:hover {
    text-decoration: underline;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: minmax(220px, 260px) minmax(170px, 200px);
    gap: 12px;
    margin-bottom: 26px;
  }

  .page-grid {
    display: none;
  }

  .page-grid.active {
    display: grid;
  }

  .tile {
    position: relative;
    display: block;
    text-decoration: none;
    color: #fff;
    border-radius: 2px;
    overflow: hidden;
    background: #f1f5f9;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.65));
  }

  .tile:hover img {
    transform: scale(1.04);
  }

  .tile-main {
    grid-column: 1 / span 2;
    grid-row: 1;
  }

  .tile-tall {
    grid-column: 3;
    grid-row: 1 / span 2;
  }

  .tile-small-left {
    grid-column: 1;
    grid-row: 2;
  }

  .tile-small-right {
    grid-column: 2;
    grid-row: 2;
  }

  .overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 16px 14px 12px;
  }

  .overlay h2 {
    margin: 0 0 6px;
    font-size: 1.55rem;
    line-height: 1.18;
    font-weight: 700;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  .tile-small-left .overlay h2,
  .tile-small-right .overlay h2,
  .tile-tall .overlay h2 {
    font-size: 1.05rem;
  }

  .overlay p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pager {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin: 8px 0 6px;
  }

  .pager-btn {
    border: none;
    background: transparent;
    color: #f08b99;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    padding: 2px 6px;
  }

  .pager-btn.active {
    color: #e85d6f;
    text-decoration: underline;
  }

  .empty {
    color: #64748b;
    line-height: 1.8;
    margin: 18px 0;
  }

  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 220px 180px 180px;
    }

    .tile-main {
      grid-column: 1 / span 2;
      grid-row: 1;
    }

    .tile-tall {
      grid-column: 2;
      grid-row: 2 / span 2;
    }

    .tile-small-left {
      grid-column: 1;
      grid-row: 2;
    }

    .tile-small-right {
      grid-column: 1;
      grid-row: 3;
    }

    .overlay h2 {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 640px) {
    .featured-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(4, 210px);
    }

    .tile-main,
    .tile-tall,
    .tile-small-left,
    .tile-small-right {
      grid-column: auto;
      grid-row: auto;
    }

    .overlay h2 {
      font-size: 1.05rem;
    }
  }
</style>

<script is:inline>
  ;(function () {
    var grids = Array.prototype.slice.call(document.querySelectorAll('.page-grid'))
    var btns = Array.prototype.slice.call(document.querySelectorAll('.pager-btn'))
    if (!grids.length || !btns.length) return

    function setPage(page) {
      grids.forEach(function (grid) {
        grid.classList.toggle('active', Number(grid.getAttribute('data-page')) === page)
      })
      btns.forEach(function (btn) {
        btn.classList.toggle('active', Number(btn.getAttribute('data-page-btn')) === page)
      })
    }

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var page = Number(btn.getAttribute('data-page-btn') || '1')
        setPage(page)
      })
    })
  })()
</script>
