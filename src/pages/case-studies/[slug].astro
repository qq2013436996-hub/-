---
import {sanityClient} from 'sanity:client'
import {PortableText} from 'astro-portabletext'
import type {TypedObject} from '@portabletext/types'
import MainLayout from '../../layouts/MainLayout.astro'

type LinkRow = {title: string | null; slug: string | null}

export const prerender = false

const {slug} = Astro.params

const doc = await sanityClient.fetch<{
  title: string | null
  projectType: string | null
  clientType: string | null
  country: string | null
  industry: string | null
  projectYear: number | null
  summary: string | null
  heroImageUrl: string | null
  heroImageAlt: string | null
  content: TypedObject[] | null
  clientBackground: string | null
  challenge: TypedObject[] | null
  solution: TypedObject[] | null
  result: Array<{metric: string | null; description: string | null}> | null
  clientFeedback: string | null
  gallery: Array<{url: string | null; alt: string | null}> | null
  usedProducts: LinkRow[] | null
  relatedApplications: LinkRow[] | null
  similarCaseStudies: LinkRow[] | null
  inquiryCtaText: string | null
  seo: {
    metaTitle: string | null
    metaDescription: string | null
    canonicalUrl: string | null
    ogTitle: string | null
    ogDescription: string | null
    ogImageUrl: string | null
    robots: string | null
  } | null
} | null>(
  `*[_type == "caseStudy" && slug.current == $slug][0]{
    title,
    projectType,
    clientType,
    country,
    industry,
    projectYear,
    summary,
    "heroImageUrl": heroImage.image.asset->url,
    "heroImageAlt": heroImage.alt,
    content,
    clientBackground,
    challenge,
    solution,
    result,
    clientFeedback,
    "gallery": gallery[]{
      "url": image.asset->url,
      alt
    },
    "usedProducts": usedProducts[]->{title, "slug": slug.current},
    "relatedApplications": relatedApplications[]->{title, "slug": slug.current},
    "similarCaseStudies": similarCaseStudies[]->{title, "slug": slug.current},
    inquiryCtaText,
    seo{
      metaTitle,
      metaDescription,
      canonicalUrl,
      ogTitle,
      ogDescription,
      "ogImageUrl": ogImage.asset->url,
      robots
    }
  }`,
  {slug},
)

if (!doc) {
  return Astro.redirect('/', 302)
}

const fallbackTitle = `${doc.title ?? doc.projectType ?? 'Shows & Events'} | bike`
const pageTitle = doc.seo?.metaTitle?.trim() || fallbackTitle
const pageDescription =
  doc.seo?.metaDescription?.trim() || doc.summary || 'Shows and events with linked products and applications.'
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  seo={{
    canonicalUrl: doc.seo?.canonicalUrl || `/case-studies/${slug}/`,
    ogTitle: doc.seo?.ogTitle,
    ogDescription: doc.seo?.ogDescription,
    ogImage: doc.seo?.ogImageUrl || doc.heroImageUrl,
    robots: doc.seo?.robots,
  }}
>
  <main class="container">
    <p class="eyebrow">Shows & Events</p>
    <h1>{doc.title}</h1>
    <div class="meta">
      {doc.projectType ? <span>{doc.projectType}</span> : null}
      {doc.clientType ? <span>{doc.clientType}</span> : null}
      {doc.industry ? <span>{doc.industry}</span> : null}
      {doc.country ? <span>{doc.country}</span> : null}
      {doc.projectYear ? <span>{doc.projectYear}</span> : null}
    </div>
    {doc.summary ? <p class="lead">{doc.summary}</p> : null}
    {doc.heroImageUrl ? <img src={doc.heroImageUrl} alt={doc.heroImageAlt ?? doc.title ?? 'Shows & events'} class="hero" /> : null}
    <article class="prose">
      {doc.content ? <PortableText value={doc.content} /> : <p>Content coming soon.</p>}
    </article>
    {doc.clientBackground ? (
      <section class="block">
        <h2>Client Background</h2>
        <p>{doc.clientBackground}</p>
      </section>
    ) : null}
    {doc.challenge ? (
      <section class="block">
        <h2>Challenge</h2>
        <div class="prose"><PortableText value={doc.challenge} /></div>
      </section>
    ) : null}
    {doc.solution ? (
      <section class="block">
        <h2>Solution</h2>
        <div class="prose"><PortableText value={doc.solution} /></div>
      </section>
    ) : null}
    {(doc.result ?? []).length ? (
      <section class="block">
        <h2>Results</h2>
        <div class="result-grid">
          {(doc.result ?? []).map((row) => (
            <div class="result-card">
              <h3>{row.metric}</h3>
              <p>{row.description}</p>
            </div>
          ))}
        </div>
      </section>
    ) : null}
    {doc.clientFeedback ? (
      <section class="block quote">
        <h2>Client Feedback</h2>
        <blockquote>{doc.clientFeedback}</blockquote>
      </section>
    ) : null}
    {(doc.gallery ?? []).length ? (
      <section class="block">
        <h2>Gallery</h2>
        <div class="gallery">
          {(doc.gallery ?? []).map((img) =>
            img.url ? <img src={img.url} alt={img.alt ?? doc.title ?? 'Shows & events image'} loading="lazy" /> : null,
          )}
        </div>
      </section>
    ) : null}
    <p class="cta">
      <a href="/request-quote">{doc.inquiryCtaText || 'Request a Quote'}</a>
    </p>

    <section class="links">
      <div>
        <h2>Used Products</h2>
        <ul>
          {(doc.usedProducts ?? []).map((item) =>
            item.slug ? <li><a href={`/products/${item.slug}`}>{item.title}</a></li> : null,
          )}
        </ul>
      </div>
      <div>
        <h2>Related Applications</h2>
        <ul>
          {(doc.relatedApplications ?? []).map((item) =>
            item.slug ? <li><a href={`/applications/${item.slug}`}>{item.title}</a></li> : null,
          )}
        </ul>
      </div>
      <div>
        <h2>Similar Shows & Events</h2>
        <ul>
          {(doc.similarCaseStudies ?? []).map((item) =>
            item.slug ? <li><a href={`/case-studies/${item.slug}`}>{item.title}</a></li> : null,
          )}
        </ul>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .container { max-width: 1000px; margin: 0 auto; padding: 40px 20px; }
  .eyebrow { margin: 0 0 10px; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.8rem; }
  h1 { margin: 0 0 10px; }
  .meta { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 14px; }
  .meta span { font-size: 0.82rem; color: #475569; border: 1px solid #e5e7eb; border-radius: 999px; padding: 4px 10px; background: #fff; }
  .lead { margin: 0 0 16px; color: #64748b; line-height: 1.8; }
  .hero { width: 100%; border-radius: 12px; border: 1px solid #e5e7eb; margin: 0 0 20px; }
  .prose { line-height: 1.8; color: #334155; }
  .block { margin-top: 26px; }
  .block h2 { margin: 0 0 10px; font-size: 1.15rem; }
  .result-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .result-card { border: 1px solid #e5e7eb; border-radius: 10px; padding: 12px; background: #fff; }
  .result-card h3 { margin: 0 0 6px; font-size: 1rem; color: #0f172a; }
  .result-card p { margin: 0; color: #475569; line-height: 1.6; }
  .quote blockquote { margin: 0; padding: 12px 14px; border-left: 4px solid #cbd5e1; background: #f8fafc; color: #334155; border-radius: 8px; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .gallery img { width: 100%; height: 170px; object-fit: cover; border-radius: 10px; border: 1px solid #e5e7eb; }
  .cta a { display: inline-flex; background: var(--primary-color, #ff6600); color: #fff; text-decoration: none; padding: 10px 14px; border-radius: 8px; font-weight: 700; margin-top: 12px; }
  .links { margin-top: 28px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
  .links > div { border: 1px solid #e5e7eb; border-radius: 10px; padding: 12px; background: #fff; }
  .links h2 { margin: 0 0 8px; font-size: 1rem; }
  .links ul { margin: 0; padding-left: 18px; color: #475569; line-height: 1.7; }
  .links a {
    color: #334155;
    text-decoration: none;
    border-bottom: 1px solid rgba(51, 65, 85, 0.26);
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .links a:hover {
    color: #0f172a;
    border-bottom-color: #0f172a;
  }
</style>
