---
import {sanityClient} from 'sanity:client'
import MainLayout from '../../layouts/MainLayout.astro'

type CaseRow = {
  title: string | null
  slug: string | null
  summary: string | null
  projectType: string | null
  country: string | null
  imageUrl: string | null
  imageAlt: string | null
}

const rows = await sanityClient.fetch<CaseRow[]>(
  `*[_type == "caseStudy" && defined(slug.current)] | order(_updatedAt desc){
    title,
    "slug": slug.current,
    summary,
    projectType,
    country,
    "imageUrl": heroImage.image.asset->url,
    "imageAlt": heroImage.alt
  }`,
)

const items = (rows ?? []).filter((row): row is CaseRow & {slug: string} => Boolean(row.slug))
---

<MainLayout
  title="Case Studies | bike"
  description="Read project case studies and see linked products and applications."
  seo={{canonicalUrl: '/case-studies/'}}
>
  <main class="container">
    <header class="head">
      <h1>Case Studies</h1>
      <p>Real project outcomes with practical implementation details.</p>
    </header>
    <div class="grid">
      {items.length ? (
        items.map((item) => (
          <a class="card" href={`/case-studies/${item.slug}`}>
            {item.imageUrl ? <img src={item.imageUrl} alt={item.imageAlt ?? item.title ?? 'Case study'} loading="lazy" /> : null}
            <h2>{item.title}</h2>
            <p class="meta">{item.projectType || 'Project'}{item.country ? ` · ${item.country}` : ''}</p>
          </a>
        ))
      ) : (
        <p>No case studies yet. Add and publish `caseStudy` documents in Sanity Studio.</p>
      )}
    </div>
  </main>
</MainLayout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 40px 20px; }
  .head { margin-bottom: 18px; }
  .head h1 { margin: 0 0 8px; }
  .head p { margin: 0; color: #64748b; line-height: 1.8; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
  .card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: #fff;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12);
    border-color: #cbd5e1;
  }
  .card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-bottom: 1px solid #e5e7eb;
    transition: transform 0.35s ease, filter 0.35s ease;
    transform-origin: center;
  }
  .card:hover img {
    transform: scale(1.04);
    filter: saturate(1.05) contrast(1.03);
  }
  .card h2 { margin: 12px 12px 6px; font-size: 1.04rem; }
  .card .meta { margin: 0 12px 12px; color: #334155; font-weight: 700; font-size: 0.88rem; }
</style>
