---
import {sanityClient} from 'sanity:client'
import MainLayout from '../../layouts/MainLayout.astro'

type CaseRow = {
  title: string | null
  slug: string | null
  summary: string | null
  projectType: string | null
  country: string | null
  imageUrl: string | null
  imageAlt: string | null
  eventStartDate: string | null
  eventEndDate: string | null
  venue: string | null
  boothNumber: string | null
  showWebsiteUrl: string | null
  appointmentUrl: string | null
}

const rows = await sanityClient.fetch<CaseRow[]>(
  `*[_type == "caseStudy" && defined(slug.current)] | order(coalesce(eventStartDate, _updatedAt) desc){
    title,
    "slug": slug.current,
    summary,
    projectType,
    country,
    "imageUrl": heroImage.image.asset->url,
    "imageAlt": heroImage.alt,
    eventStartDate,
    eventEndDate,
    venue,
    boothNumber,
    showWebsiteUrl,
    appointmentUrl
  }`,
)

const items = (rows ?? []).filter((row): row is CaseRow & {slug: string} => Boolean(row.slug))

function formatIsoDate(d: string | null | undefined) {
  if (!d) return null
  const part = d.includes('T') ? d.split('T')[0] : d.slice(0, 10)
  return part || null
}

function formatDateRange(start: string | null, end: string | null) {
  const a = formatIsoDate(start)
  const b = formatIsoDate(end)
  if (a && b) return a === b ? a : `${a} - ${b}`
  if (a) return a
  if (b) return b
  return null
}

function resolveAppointmentHref(raw: string | null | undefined) {
  const s = raw?.trim()
  if (!s) return '/contact'
  if (s.startsWith('http://') || s.startsWith('https://')) return s
  if (s.startsWith('/')) return s
  return `/${s}`
}
---

<MainLayout
  title="Shows & Events | bike"
  description="Browse trade shows and events — visit our booth or book an appointment with our team."
  seo={{canonicalUrl: '/case-studies/'}}
>
  <div class="shows-page">
    <section class="shows-hero" aria-label="Shows and events">
      <img
        class="shows-hero-bg"
        src="/shows-events/hero-bg.png"
        alt=""
        width="1024"
        height="682"
        loading="eager"
        fetchpriority="high"
      />
      <div class="shows-hero-overlay"></div>
      <div class="shows-hero-inner">
        <h1>Shows & Events</h1>
      </div>
    </section>

    <div class="shows-wrap">
      {items.length ? (
        <ul class="event-list">
          {items.map((item) => {
            const dateLine = formatDateRange(item.eventStartDate, item.eventEndDate)
            const location = item.venue?.trim() || item.country?.trim() || ''
            const appointmentHref = resolveAppointmentHref(item.appointmentUrl)
            const detailHref = `/case-studies/${item.slug}`
            return (
              <li>
                <article class="event-card">
                  <div class="event-card-media">
                    {item.imageUrl ? (
                      <a class="event-card-media-fill" href={detailHref}>
                        <img
                          src={item.imageUrl}
                          alt={item.imageAlt ?? item.title ?? 'Event'}
                          width="640"
                          height="480"
                          loading="lazy"
                        />
                      </a>
                    ) : (
                      <div class="event-card-media-fallback" aria-hidden="true"></div>
                    )}
                  </div>
                  <div class="event-card-body">
                    <h2 class="event-title">
                      <a href={detailHref}>{item.title}</a>
                    </h2>
                    {(dateLine || location) ? (
                      <p class="event-meta">
                        {dateLine ? (
                          <span class="event-meta-dates">
                            <svg class="cal" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                              <path
                                fill="currentColor"
                                d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"
                              />
                            </svg>
                            {dateLine}
                          </span>
                        ) : null}
                        {location ? <span class="event-meta-loc">{location}</span> : null}
                      </p>
                    ) : null}
                    {item.summary ? <p class="event-desc">{item.summary}</p> : null}
                    {item.boothNumber?.trim() ? (
                      <p class="event-booth">
                        <strong>Booth No.:</strong> {item.boothNumber.trim()}
                      </p>
                    ) : null}
                    <div class="event-actions">
                      <a class="btn-coral-solid" href={appointmentHref}>
                        Get Appointment
                      </a>
                      {item.showWebsiteUrl?.trim() ? (
                        <a
                          class="link-show"
                          href={item.showWebsiteUrl.trim()}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Visit Show Website &gt;&gt;
                        </a>
                      ) : null}
                    </div>
                  </div>
                </article>
              </li>
            )
          })}
        </ul>
      ) : (
        <div class="shows-empty">
          <p>No shows or events yet. Add and publish Shows &amp; Events documents in Sanity Studio.</p>
        </div>
      )}

      <section class="shows-cta-band" aria-labelledby="shows-cta-heading">
        <h2 id="shows-cta-heading">Contact our specialist</h2>
        <p class="shows-cta-sub">We're here to help you</p>
        <a href="/request-quote" class="btn-coral-solid">Get An Instant Quote</a>
      </section>
    </div>
  </div>
</MainLayout>

<style>
  .shows-page {
    background: #eceff3;
  }

  .shows-hero {
    position: relative;
    min-height: min(52vw, 420px);
    max-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .shows-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.03);
  }

  .shows-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.35) 0%, rgba(15, 23, 42, 0.55) 100%);
  }

  .shows-hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 48px 20px;
  }

  .shows-hero-inner h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5.5vw, 3.35rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .shows-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 20px 0;
  }

  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .event-card {
    display: grid;
    grid-template-columns: minmax(260px, 380px) minmax(0, 1fr);
    gap: 0;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06);
    overflow: hidden;
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .event-card:hover {
    box-shadow: 0 10px 32px rgba(15, 23, 42, 0.1);
    border-color: #cbd5e1;
  }

  .event-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #f1f5f9;
    overflow: hidden;
  }

  .event-card-media-fill {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
  }

  .event-card-media-fill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.35s ease;
  }

  .event-card:hover .event-card-media-fill img {
    transform: scale(1.03);
  }

  .event-card-media-fallback {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #e2e8f0, #f8fafc);
  }

  .event-card-body {
    padding: 28px 32px 32px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .event-title {
    margin: 0 0 12px;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 800;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .event-title a {
    color: #0f172a;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .event-title a:hover {
    color: #c45c63;
    border-bottom-color: rgba(240, 113, 121, 0.5);
  }

  .event-meta {
    margin: 0 0 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    font-size: 0.95rem;
    color: #64748b;
  }

  .event-meta-dates {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #475569;
    font-weight: 600;
  }

  .event-meta-dates .cal {
    flex-shrink: 0;
    opacity: 0.85;
  }

  .event-meta-loc {
    color: #94a3b8;
    font-weight: 500;
  }

  .event-desc {
    margin: 0 0 14px;
    color: #334155;
    line-height: 1.75;
    font-size: 0.98rem;
    white-space: pre-line;
  }

  .event-booth {
    margin: 0 0 22px;
    font-size: 0.98rem;
    color: #1e293b;
  }

  .event-actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
  }

  .link-show {
    color: var(--coral-cta, #f07179);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(240, 113, 121, 0.45);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .link-show:hover {
    color: #d85d65;
    border-bottom-color: #d85d65;
  }

  .shows-empty {
    background: #fff;
    border: 1px dashed #cbd5e1;
    border-radius: 4px;
    padding: 40px 24px;
    text-align: center;
    color: #64748b;
    line-height: 1.7;
  }

  .shows-cta-band {
    margin: 48px -20px 0;
    padding: 48px 20px 52px;
    text-align: center;
    background: #fdecef;
    border-top: 1px solid #f9d6dc;
  }

  .shows-cta-band h2 {
    margin: 0 0 8px;
    font-size: clamp(1.65rem, 3vw, 2.1rem);
    font-weight: 800;
    color: #334155;
    letter-spacing: -0.02em;
  }

  .shows-cta-sub {
    margin: 0 0 22px;
    color: #64748b;
    font-size: 1.05rem;
  }

  @media (max-width: 820px) {
    .event-card {
      grid-template-columns: 1fr;
    }

    .event-card-body {
      padding: 22px 20px 26px;
    }

    .shows-cta-band {
      margin-left: -20px;
      margin-right: -20px;
    }
  }
</style>
