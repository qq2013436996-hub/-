---
import {sanityClient} from 'sanity:client'
import MainLayout from '../layouts/MainLayout.astro'

type SettingsRow = {
  companyName: string | null
  companyDescription: string | null
}

type BlogRow = {
  title: string | null
  slug: string | null
  excerpt: string | null
  publishedAt: string | null
  imageUrl: string | null
}

const settings = await sanityClient.fetch<SettingsRow | null>(`*[_type=="siteSettings"][0]{
  companyName,
  companyDescription
}`)

const blogRows = await sanityClient.fetch<BlogRow[]>(
  `*[_type == "blogPost" && defined(slug.current)] | order(coalesce(publishedAt, _createdAt) desc)[0...3]{
    title,
    "slug": slug.current,
    excerpt,
    publishedAt,
    "imageUrl": coalesce(featuredImage.image.asset->url, coverImage.asset->url)
  }`,
)

const blogs = (blogRows ?? []).filter((row): row is BlogRow & {slug: string} => Boolean(row.slug))
const displayName = settings?.companyName?.trim() || 'MW Candle'
const homeTitle = `Scented Candles Wholesale Manufacturer | ${displayName}`
const homeDescription =
  settings?.companyDescription?.trim() ||
  'Wholesale scented candle manufacturer with OEM/ODM service, custom fragrances, and stable production capacity.'

type HomeFaqItem = {question: string; answer: string}

const defaultHomeFaqs: HomeFaqItem[] = [
  {
    question: 'Can I fully customize the candle fragrance and packaging?',
    answer:
      'Yes. We support custom fragrance profiles, vessel styles, labels, gift boxes, and inserts. Share your brand guidelines and we will walk you through sampling to mass production.',
  },
  {
    question: 'Do you offer eco-friendly and sustainable options?',
    answer:
      'We offer plant-based waxes, recyclable and FSC-minded packaging options, and cleaner-burning formulations. Tell us your sustainability targets and we will recommend a compliant path.',
  },
  {
    question: 'How quickly can I receive a bulk order?',
    answer:
      'Lead time depends on SKU complexity, MOQ, and season. After artwork and fragrance approval, we provide a clear production schedule—most programs move from deposit to ex-factory on an agreed timeline.',
  },
  {
    question: "What if I'm outside of China—do you ship internationally?",
    answer:
      'We regularly ship to importers and brands worldwide. We can coordinate export documentation and work with your forwarder or ours depending on the Incoterms you prefer.',
  },
  {
    question: 'Can I order in small batches first?',
    answer:
      'Yes. We support flexible MOQs for trial runs so you can validate packaging and scent performance before scaling. Ask our team for the current MOQ table for your product format.',
  },
]

const sanityHomeFaqs = await sanityClient.fetch<{question: string | null; answer: string | null}[]>(
  `*[_type == "faq"] | order(coalesce(displayOrder, sortOrder, 100) asc)[0...16]{
    question,
    answer
  }`,
)

function buildHomeFaqs(): HomeFaqItem[] {
  const raw = (sanityHomeFaqs ?? []).filter((r) => Boolean(r.question?.trim()))
  const out: HomeFaqItem[] = []
  const seen = new Set<string>()
  for (const r of raw) {
    if (out.length >= 5) break
    const q = r.question!.trim()
    const key = q.toLowerCase()
    if (seen.has(key)) continue
    seen.add(key)
    const a = (r.answer ?? '').trim()
    out.push({
      question: q,
      answer: a || 'See our Help Center for the full answer or contact us for details.',
    })
  }
  for (const d of defaultHomeFaqs) {
    if (out.length >= 5) break
    const key = d.question.toLowerCase()
    if (seen.has(key)) continue
    seen.add(key)
    out.push(d)
  }
  return out.slice(0, 5)
}

const homeFaqs = buildHomeFaqs()

const scentTypes = [
  {
    title: 'Floral',
    description:
      'Infuse your brand and events with the fresh elegance of floral scents, creating a soft, inviting atmosphere.',
    image: '/products/types/floral.png',
  },
  {
    title: 'Fruity',
    description:
      'Sweet fruity fragrances deliver a fresh, delightful sensory experience for your gifts and events, leaving a lasting impression.',
    image: '/products/types/fruity.png',
  },
  {
    title: 'Woody',
    description:
      'Rich woody scents bring warmth and depth, adding a unique touch to your brand and seasonal promotions.',
    image: '/products/types/woody.png',
  },
  {
    title: 'Spicy',
    description:
      'Spicy scents ignite special moments, infusing your gifting and promotional events with bold character and energy.',
    image: '/products/types/spicy.png',
  },
  {
    title: 'Fresh',
    description:
      'Fresh aromas enhance your hospitality and events, offering a clean, invigorating experience for guests.',
    image: '/products/types/fresh.png',
  },
  {
    title: 'More scents',
    description:
      'Explore our range of custom scented candles, offering something unique and special for every occasion.',
    image: '/products/types/more-scents.png',
  },
]

const factoryImages = [
  '/home/factory-1.png',
  '/home/factory-2.png',
  '/home/factory-3.png',
  '/home/factory-4.png',
  '/home/factory-5.png',
  '/home/factory-6.png',
  '/home/factory-7.png',
  '/home/factory-8.png',
]

const factoryRowTop = [
  factoryImages[2],
  factoryImages[3],
  factoryImages[4],
  factoryImages[5],
  factoryImages[2],
  factoryImages[3],
]

const factoryRowBottom = [
  factoryImages[6],
  factoryImages[7],
  factoryImages[0],
  factoryImages[1],
  factoryImages[6],
  factoryImages[7],
]

const testimonials = [
  {
    name: 'Emily T.',
    role: 'Corporate Buyer',
    quote:
      'We needed a gift solution fast for 8k+ futures and this team delivered beautiful custom candles.',
    avatar: '/home/customers/customer-1.png',
  },
  {
    name: 'Chloe Z.',
    role: 'Event Coordinator',
    quote:
      'Pairing events is stressful, but their team made it easy. The candles transformed our venue.',
    avatar: '/home/customers/customer-2.png',
  },
  {
    name: 'Marcus L.',
    role: 'Retail Manager',
    quote: 'Our boutique saw an immediate uptick in sales after adding their seasonal scents.',
    avatar: '/home/customers/customer-3.png',
  },
]

const featureBlocks = [
  ['Features One', 'Tailored to you · Choose from custom packaging, fragrances, and wax types to match your brand identity.'],
  ['Features Two', 'Eco-Friendly Focus · We use soy, beeswax, coconut, and sustainable packaging to elevate your environmental values.'],
  ['Features Three', 'Fast and Flexible Production · 10 production lines and rapid prototyping help you meet tight deadlines.'],
  ['Features Four', 'Stable Supply Chain · In-house design, domestic sourcing, and long-term supplier partnerships ensure reliable output.'],
  ['Features Five', 'International Trust · Shipped to over 130 countries, trusted by global brands for 15 years.'],
  ['Features Six', 'Full-Service Support · From design to delivery, we guide you through every step.'],
] as const

const blogList = blogs.length
  ? blogs
  : [
      {
        title: 'Late Summer to Fall Transition Scents',
        slug: '#',
        excerpt: 'Bridge seasons with scented candles.',
        publishedAt: null,
        imageUrl: '/products/types/woody.png',
      },
    ]
---

<MainLayout title={homeTitle} description={homeDescription} seo={{canonicalUrl: '/'}}>
  <main class="home-page">
    <div class="home-marquee" aria-hidden="true">
      <div class="home-marquee-track">
        <span>OEM / ODM</span>
        <span class="home-dot">·</span>
        <span>130+ countries shipped</span>
        <span class="home-dot">·</span>
        <span>15 years export craft</span>
        <span class="home-dot">·</span>
        <span>10 production lines</span>
        <span class="home-dot">·</span>
        <span>Reply within 24h</span>
        <span class="home-dot">·</span>
        <span>OEM / ODM</span>
        <span class="home-dot">·</span>
        <span>130+ countries shipped</span>
        <span class="home-dot">·</span>
        <span>15 years export craft</span>
        <span class="home-dot">·</span>
        <span>10 production lines</span>
        <span class="home-dot">·</span>
        <span>Reply within 24h</span>
      </div>
    </div>

    <section class="home-hero" aria-labelledby="home-hero-heading">
      <div class="home-hero-grid">
        <div class="home-hero-copy">
          <p class="home-eyebrow">{displayName}</p>
          <h1 id="home-hero-heading" class="home-display">
            <span class="home-display-line">Wholesale candle craft</span>
            <span class="home-display-line home-display-accent">for brands that want</span>
            <span class="home-display-line">a quiet kind of luxury.</span>
          </h1>
          <p class="home-lede">
            With our wholesale candle manufacturing services, we provide unique custom scented candle solutions
            for your retail, branding, events, and gifting—making every moment more captivating.
          </p>
          <div class="home-hero-actions">
            <a href="/contact" class="home-btn home-btn-solid">Contact</a>
            <a href="/request-quote" class="home-btn home-btn-ghost">Request a quote</a>
            <a href="/products" class="home-link-arrow">Browse capabilities →</a>
          </div>
        </div>
        <figure class="home-hero-visual">
          <img
            src="/home/hero-banner.png"
            alt="Scented candles wholesale manufacturing"
            loading="eager"
            decoding="async"
          />
          <figcaption class="home-caption">Wholesale production</figcaption>
        </figure>
      </div>
    </section>

    <section class="home-statement" aria-label="Brand positioning">
      <p class="home-statement-text">
        {homeDescription}
      </p>
    </section>

    <section class="home-section home-scents" aria-labelledby="scents-heading">
      <header class="home-section-head">
        <span class="home-index">01</span>
        <div>
          <p class="home-kicker">Olfactory families</p>
          <h2 id="scents-heading" class="home-section-title">Types of scented candles</h2>
        </div>
      </header>
      <div class="home-scent-grid">
        {scentTypes.map((item) => (
          <a class="home-scent-card" href="/request-quote">
            <div class="home-scent-media">
              <img src={item.image} alt={item.title} loading="lazy" />
            </div>
            <div class="home-scent-body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <span class="home-scent-cta">Configure & sample →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="home-band" aria-labelledby="band-heading">
      <div class="home-band-inner">
        <div>
          <p class="home-kicker home-kicker-on-dark">Next step</p>
          <h2 id="band-heading" class="home-band-title">Your scent solution awaits</h2>
          <p class="home-band-text">Explore Our Premium Candle Collection</p>
        </div>
        <a href="/request-quote" class="home-btn home-btn-light">Quote now</a>
      </div>
    </section>

    <section class="home-section home-pillars" aria-labelledby="pillars-heading">
      <header class="home-section-head home-section-head-split">
        <div class="home-pillars-intro">
          <span class="home-index">02</span>
          <p class="home-kicker">Capability matrix</p>
          <h2 id="pillars-heading" class="home-section-title">Why your business needs {displayName}</h2>
        </div>
      </header>
      <div class="home-feature-matrix">
        {featureBlocks.map((f, idx) => (
          <article class="home-feature-row">
            <span class="home-feature-num">{String(idx + 1).padStart(2, '0')}</span>
            <div>
              <h3>{f[0]}</h3>
              <p>{f[1]}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="home-split" aria-labelledby="about-heading">
      <div class="home-split-visual">
        <img src="/home/building.png" alt="MW Candle facility exterior" loading="lazy" />
      </div>
      <div class="home-split-copy">
        <span class="home-index">03</span>
        <p class="home-kicker">Heritage &amp; rigor</p>
        <h2 id="about-heading">What sets {displayName} apart</h2>
        <p>
          With over 15 years of foreign trade experience and clients across 130+ countries, {displayName}
          combines expert craftsmanship with innovative design. Backed by high-tech facility and passionate team,
          our candles are created with precision, creativity, and reliability.
        </p>
        <a href="/introduction" class="home-btn home-btn-solid">More about us</a>
      </div>
    </section>

    <section class="home-section home-factory" aria-labelledby="factory-heading">
      <header class="home-factory-head">
        <span class="home-index">04</span>
        <div>
          <p class="home-kicker">Manufacturing</p>
          <h2 id="factory-heading">Your strategic partner in luxury candle manufacturing</h2>
          <p>
            When you partner with {displayName}, you’re not just selecting a manufacturer—you’re choosing a
            strategic collaborator committed to elevating your business.
          </p>
        </div>
        <a href="/request-quote" class="home-btn home-btn-ghost home-factory-cta">Get a free quote</a>
      </header>
      <div class="home-factory-marquee" aria-hidden="true">
        <div class="home-factory-row row-right">
          {[...factoryRowTop, ...factoryRowTop].map((img) => (
            <img src={img} alt="" loading="lazy" />
          ))}
        </div>
        <div class="home-factory-row row-left">
          {[...factoryRowBottom, ...factoryRowBottom].map((img) => (
            <img src={img} alt="" loading="lazy" />
          ))}
        </div>
      </div>
    </section>

    <section class="home-section home-voices" aria-labelledby="voices-heading">
      <header class="home-voices-head">
        <span class="home-index">05</span>
        <div>
          <p class="home-kicker">Field notes</p>
          <h2 id="voices-heading" class="home-section-title">What our customers say</h2>
        </div>
      </header>
      <div class="home-quote-grid">
        {testimonials.map((t, i) => (
          <figure class="home-quote">
            <blockquote>“{t.quote}”</blockquote>
            <figcaption>
              <img src={t.avatar} alt="" width="48" height="48" loading="lazy" />
              <div>
                <cite>{t.name}</cite>
                <span>{t.role}</span>
                <span class="home-quote-date">
                  {new Date(2025, 4, 12 + i * 9).toLocaleString('en-US', {month: 'long', year: 'numeric'})}
                </span>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="home-section home-journal" aria-labelledby="journal-heading">
      <header class="home-journal-head">
        <div>
          <span class="home-index">06</span>
          <p class="home-kicker">Journal</p>
          <h2 id="journal-heading" class="home-section-title">Blog</h2>
          <p class="home-journal-dek">
            From the history and benefits of scented candles to DIY guides, safety tips, and decor ideas.
          </p>
        </div>
        <a href="/blog" class="home-btn home-btn-ghost">View all</a>
      </header>
      <div class="home-journal-grid">
        {blogList.map((b) => (
          <a class="home-journal-card" href={b.slug === '#' ? '/blog' : `/blog/${b.slug}`}>
            <div class="home-journal-media">
              <img src={b.imageUrl || '/products/types/floral.png'} alt="" loading="lazy" />
            </div>
            <div class="home-journal-body">
              {b.publishedAt ? (
                <time datetime={b.publishedAt}>
                  {new Date(b.publishedAt).toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </time>
              ) : (
                <span class="home-journal-time-fallback">Latest</span>
              )}
              <h3>{b.title}</h3>
              {b.excerpt ? <p>{b.excerpt}</p> : null}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="home-faq" aria-labelledby="home-faq-heading">
      <div class="home-faq-grid">
        <div class="home-faq-intro-block">
          <span class="home-index">07</span>
          <p class="home-kicker">Clarity</p>
          <h2 id="home-faq-heading">Frequently asked questions</h2>
          <p>
            Below are some frequently asked questions regarding scented candle wholesale and services. If you
            can&apos;t find what you&apos;re looking for, please feel free to contact us. Whether your business is
            complex or simple, you will get an accurate quote within 6 hours.
          </p>
          <a href="/faqs/" class="home-btn home-btn-solid">View all</a>
        </div>
        <div class="home-faq-list">
          {
            homeFaqs.map((item, idx) => (
              <details class="home-faq-item">
                <summary>
                  <span class="home-faq-n">{String(idx + 1).padStart(2, '0')}</span>
                  <span class="home-faq-q">{item.question}</span>
                  <span class="home-faq-toggle" aria-hidden="true" />
                </summary>
                <div class="home-faq-a">
                  <p>{item.answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .home-page {
    --hx-bg: #f4f1ec;
    --hx-bg-2: #ebe6df;
    --hx-ink: #14110f;
    --hx-muted: #5a534c;
    --hx-line: rgba(20, 17, 15, 0.12);
    --hx-accent: #2a2420;
    font-family: 'DM Sans', system-ui, sans-serif;
    background: var(--hx-bg);
    color: var(--hx-ink);
    letter-spacing: -0.01em;
  }

  .home-marquee {
    border-bottom: 1px solid var(--hx-line);
    background: #faf8f5;
    overflow: hidden;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 600;
    color: var(--hx-muted);
  }
  .home-marquee-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    padding: 0.55rem 0;
    animation: homeMarquee 42s linear infinite;
  }
  .home-dot {
    opacity: 0.45;
  }
  @keyframes homeMarquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-marquee-track {
      animation: none;
      justify-content: center;
      flex-wrap: wrap;
      width: auto;
      max-width: 72rem;
      margin: 0 auto;
      padding: 0.55rem 1rem;
    }
  }

  .home-hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem) clamp(3rem, 7vw, 5rem);
  }
  .home-hero-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }
  .home-eyebrow {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-weight: 600;
    color: var(--hx-muted);
  }
  .home-display {
    font-family: 'Cormorant Garamond', 'Times New Roman', serif;
    font-weight: 500;
    line-height:0.98;
    margin: 0 0 1.5rem;
    font-size: clamp(2.6rem, 5.2vw, 4.25rem);
  }
  .home-display-line {
    display: block;
  }
  .home-display-accent {
    font-style: italic;
    font-weight: 400;
    color: #3d3833;
  }
  .home-lede {
    margin: 0 0 1.75rem;
    max-width: 38rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--hx-muted);
    font-weight: 400;
  }
  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
  }
  .home-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.15s ease;
  }
  .home-btn-solid {
    background: var(--hx-accent);
    color: #faf7f2;
    border-color: var(--hx-accent);
  }
  .home-btn-solid:hover {
    background: #000;
    border-color: #000;
  }
  .home-btn-ghost {
    background: transparent;
    color: var(--hx-ink);
    border-color: var(--hx-line);
  }
  .home-btn-ghost:hover {
    border-color: var(--hx-ink);
  }
  .home-btn-light {
    background: #f4f1ec;
    color: var(--hx-ink);
    border-color: rgba(244, 241, 236, 0.35);
  }
  .home-btn-light:hover {
    background: #fff;
  }
  .home-link-arrow {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--hx-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .home-link-arrow:hover {
    color: var(--hx-ink);
    border-color: var(--hx-ink);
  }
  .home-hero-visual {
    margin: 0;
    position: relative;
  }
  .home-hero-visual img {
    width: 100%;
    display: block;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.02);
    box-shadow: 0 28px 60px rgba(20, 17, 15, 0.14);
  }
  .home-caption {
    margin: 0.65rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hx-muted);
  }

  .home-statement {
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.25rem, 4vw, 3rem);
    border-top: 1px solid var(--hx-line);
    border-bottom: 1px solid var(--hx-line);
    background: linear-gradient(180deg, #f0ebe4 0%, var(--hx-bg) 100%);
  }
  .home-statement-text {
    margin: 0 auto;
    max-width: 52rem;
    text-align: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    line-height: 1.45;
    font-weight: 400;
    color: #2f2a26;
  }

  .home-section {
    padding: clamp(3.25rem, 8vw, 6rem) clamp(1.25rem, 4vw, 3rem);
    max-width: 1200px;
    margin: 0 auto;
  }
  .home-section-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--hx-line);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .home-section-head-split {
    grid-template-columns: minmax(0, 1fr);
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }
  .home-pillars-intro {
    max-width: 40rem;
  }
  .home-index {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: var(--hx-muted);
  }
  .home-kicker {
    margin: 0.35rem 0 0.4rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 600;
    color: var(--hx-muted);
  }
  .home-kicker-on-dark {
    color: rgba(244, 241, 236, 0.65);
  }
