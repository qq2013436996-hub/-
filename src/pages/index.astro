---
import {sanityClient} from 'sanity:client'
import MainLayout from '../layouts/MainLayout.astro'

type SettingsRow = {
  companyName: string | null
  companyDescription: string | null
}

type BlogRow = {
  title: string | null
  slug: string | null
  excerpt: string | null
  publishedAt: string | null
  imageUrl: string | null
}

const settings = await sanityClient.fetch<SettingsRow | null>(`*[_type=="siteSettings"][0]{
  companyName,
  companyDescription
}`)

const blogRows = await sanityClient.fetch<BlogRow[]>(
  `*[_type == "blogPost" && defined(slug.current)] | order(coalesce(publishedAt, _createdAt) desc)[0...3]{
    title,
    "slug": slug.current,
    excerpt,
    publishedAt,
    "imageUrl": coalesce(featuredImage.image.asset->url, coverImage.asset->url)
  }`,
)

const blogs = (blogRows ?? []).filter((row): row is BlogRow & {slug: string} => Boolean(row.slug))
const displayName = settings?.companyName?.trim() || 'MW Candle'
const homeTitle = `Scented Candles Wholesale Manufacturer | ${displayName}`
const homeDescription =
  settings?.companyDescription?.trim() ||
  'Wholesale scented candle manufacturer with OEM/ODM service, custom fragrances, and stable production capacity.'

const scentTypes = [
  {
    title: 'Floral',
    description:
      'Infuse your brand and events with the fresh elegance of floral scents, creating a soft, inviting atmosphere.',
    image: '/products/types/floral.png',
  },
  {
    title: 'Fruity',
    description:
      'Sweet fruity fragrances deliver a fresh, delightful sensory experience for your gifts and events, leaving a lasting impression.',
    image: '/products/types/fruity.png',
  },
  {
    title: 'Woody',
    description:
      'Rich woody scents bring warmth and depth, adding a unique touch to your brand and seasonal promotions.',
    image: '/products/types/woody.png',
  },
  {
    title: 'Spicy',
    description:
      'Spicy scents ignite special moments, infusing your gifting and promotional events with bold character and energy.',
    image: '/products/types/spicy.png',
  },
  {
    title: 'Fresh',
    description:
      'Fresh aromas enhance your hospitality and events, offering a clean, invigorating experience for guests.',
    image: '/products/types/fresh.png',
  },
  {
    title: 'More scents',
    description:
      'Explore our range of custom scented candles, offering something unique and special for every occasion.',
    image: '/products/types/more-scents.png',
  },
]

const factoryImages = [
  '/home/factory-1.png',
  '/home/factory-2.png',
  '/home/factory-3.png',
  '/home/factory-4.png',
  '/home/factory-5.png',
  '/home/factory-6.png',
  '/home/factory-7.png',
  '/home/factory-8.png',
]

const factoryRowTop = [
  factoryImages[2],
  factoryImages[3],
  factoryImages[4],
  factoryImages[5],
  factoryImages[2],
  factoryImages[3],
]

const factoryRowBottom = [
  factoryImages[6],
  factoryImages[7],
  factoryImages[0],
  factoryImages[1],
  factoryImages[6],
  factoryImages[7],
]

const testimonials = [
  {
    name: 'Emily T.',
    role: 'Corporate Buyer',
    quote:
      'We needed a gift solution fast for 8k+ futures and this team delivered beautiful custom candles.',
    avatar: '/home/customers/customer-1.png',
  },
  {
    name: 'Chloe Z.',
    role: 'Event Coordinator',
    quote:
      'Pairing events is stressful, but their team made it easy. The candles transformed our venue.',
    avatar: '/home/customers/customer-2.png',
  },
  {
    name: 'Marcus L.',
    role: 'Retail Manager',
    quote: 'Our boutique saw an immediate uptick in sales after adding their seasonal scents.',
    avatar: '/home/customers/customer-3.png',
  },
]
---

<MainLayout title={homeTitle} description={homeDescription} seo={{canonicalUrl: '/'}}>
  <main class="home-page">
    <section class="hero">
      <img src="/home/hero-banner.png" alt="Scented candles wholesale manufacturer" loading="eager" />
      <div class="hero-overlay"></div>
      <div class="hero-inner">
        <h1>Scented Candles Wholesale Manufacturer in China</h1>
        <p>
          With our wholesale candle manufacturing services, we provide unique custom scented candle
          solutions for your retail, branding, events, and gifting, making every moment more captivating.
        </p>
        <a href="/contact" class="btn">Contact Now</a>
      </div>
    </section>

    <section class="scent-types section">
      <h2>Types of scented candles</h2>
      <div class="card-grid">
        {scentTypes.map((item) => (
          <a class="scent-card" href="/request-quote">
            <img src={item.image} alt={item.title} loading="lazy" />
            <div class="scent-body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <span>Get Fast Quote &gt;&gt;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mid-banner">
      <div class="mid-banner-overlay"></div>
      <div class="mid-banner-inner">
        <div>
          <h2>Your Scent Solution Awaits</h2>
          <p>Explore Our Premium Candle Collection</p>
        </div>
        <a href="/request-quote" class="btn">Quote Now</a>
      </div>
    </section>

    <section class="features section">
      <h2>Why Your Business Needs MW Candle</h2>
      <div class="feature-grid">
        {[
          ['Features One', 'Tailored to you · Choose from custom packaging, fragrances, and wax types to match your brand identity.'],
          ['Features Two', 'Eco-Friendly Focus · We use soy, beeswax, coconut, and sustainable packaging to elevate your environmental values.'],
          ['Features Three', 'Fast and Flexible Production · 10 production lines and rapid prototyping help you meet tight deadlines.'],
          ['Features Four', 'Stable Supply Chain · In-house design, domestic sourcing, and long-term supplier partnerships ensure reliable output.'],
          ['Features Five', 'International Trust · Shipped to over 130 countries, trusted by global brands for 15 years.'],
          ['Features Six', 'Full-Service Support · From design to delivery, we guide you through every step.'],
        ].map((f, idx) => (
          <article class="feature-card">
            <div class="icon">{idx + 1}</div>
            <h3>{f[0]}</h3>
            <p>{f[1]}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="about-split section">
      <div class="about-copy">
        <h2>What Sets MW Candle Apart</h2>
        <p>
          With over 15 years of foreign trade experience and clients across 130+ countries, MW Candle
          combines expert craftsmanship with innovative design. Backed by high-tech facility and passionate
          team, our candles are created with precision, creativity, and reliability.
        </p>
        <a href="/introduction" class="btn">More About Us</a>
      </div>
      <div class="about-image">
        <img src="/home/building.png" alt="MW Candle building" loading="lazy" />
      </div>
    </section>

    <section class="factory section">
      <h2>Your Strategic Partner in Luxury Candle Manufacturing</h2>
      <p>When you partner with MW Candle, you’re not just selecting a manufacturer—you’re choosing a strategic collaborator committed to elevating your business.</p>
      <a href="/request-quote" class="btn">Get A Free Quote</a>
      <div class="factory-marquee">
        <div class="factory-row row-right">
          {[...factoryRowTop, ...factoryRowTop].map((img) => (
            <img src={img} alt="Factory production line" loading="lazy" />
          ))}
        </div>
        <div class="factory-row row-left">
          {[...factoryRowBottom, ...factoryRowBottom].map((img) => (
            <img src={img} alt="Factory production line" loading="lazy" />
          ))}
        </div>
      </div>
    </section>

    <section class="testimonials section">
      <h2>What Our Customers Say</h2>
      <div class="testimonial-grid">
        {testimonials.map((t) => (
          <article class="testimonial">
            <div class="testimonial-head">
              <img src={t.avatar} alt={t.name} loading="lazy" />
              <div>
                <h3>{t.name}</h3>
                <span>{t.role}</span>
              </div>
            </div>
            <p>{t.quote}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="home-blog section">
      <div class="head-row">
        <div>
          <h2>Blog</h2>
          <p>
            Discover a variety of topics on our blog—from the history and benefits of scented candles to DIY
            guides, safety tips, and decor ideas.
          </p>
        </div>
        <a href="/blog" class="btn">View All</a>
      </div>
      <div class="blog-grid">
        {(blogs.length ? blogs : [
          {
            title: 'Late Summer to Fall Transition Scents',
            slug: '#',
            excerpt: 'Bridge seasons with scented candles.',
            publishedAt: null,
            imageUrl: '/products/types/woody.png',
          },
        ]).map((b) => (
          <a class="blog-card" href={b.slug === '#' ? '/blog' : `/blog/${b.slug}`}>
            <img src={b.imageUrl || '/products/types/floral.png'} alt={b.title ?? 'Blog'} loading="lazy" />
            <div class="meta-row">
              <span>{b.publishedAt ? new Date(b.publishedAt).toLocaleDateString() : 'Latest'}</span>
            </div>
            <h3>{b.title}</h3>
          </a>
        ))}
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .home-page { background:#fff; color:#111; }
  .section { max-width:1140px; margin:0 auto; padding:42px 20px; }
  h2 { margin:0 0 16px; font-size: clamp(1.5rem,2.8vw,2.15rem); font-weight:800; letter-spacing:-0.01em; text-align:center; }
  p { color:#4b5563; line-height:1.7; }
  .btn { display:inline-flex; align-items:center; justify-content:center; padding:10px 18px; border-radius:6px; background:#f07179; color:#fff; text-decoration:none; font-weight:700; font-size:.9rem; border:none; }

  .hero { position:relative; min-height:520px; display:flex; align-items:center; }
  .hero > img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .hero-overlay { position:absolute; inset:0; background:rgba(0,0,0,.46); }
  .hero-inner {
    position:relative;
    z-index:1;
    width:100%;
    padding:0 clamp(18px, 8vw, 96px);
    color:#fff;
  }
  .hero-inner h1 {
    margin:0 0 14px;
    max-width:720px;
    font-size:clamp(2.15rem, 4.3vw, 4rem);
    line-height:1.08;
    font-weight:800;
    letter-spacing:-0.015em;
  }
  .hero-inner p { max-width:610px; margin:0 0 22px; color:#f3f4f6; font-size:1.07rem; line-height:1.65; }

  .card-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  .scent-card { border:1px solid #e5e7eb; text-decoration:none; color:inherit; background:#fff; transition:transform .22s ease, box-shadow .22s ease; }
  .scent-card:hover { transform: translateY(-3px); box-shadow:0 12px 24px rgba(15,23,42,.1); }
  .scent-card img { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; border-bottom:1px solid #e5e7eb; }
  .scent-body { padding:9px 10px 12px; }
  .scent-body h3 { margin:0 0 6px; font-size:1.7rem; line-height:1.05; }
  .scent-body p { margin:0 0 8px; font-size:.86rem; min-height:56px; }
  .scent-body span { color:#f07179; font-size:.84rem; font-weight:700; }

  .mid-banner { position:relative; min-height:128px; background:linear-gradient(rgba(28,22,18,.4),rgba(28,22,18,.4)),url('/contact/hero-candles.png') center/cover no-repeat; display:flex; align-items:center; margin: 18px 0 0; }
  .mid-banner-inner { position:relative; z-index:1; max-width:1140px; width:100%; margin:0 auto; padding:0 20px; display:flex; justify-content:space-between; align-items:center; }
  .mid-banner h2 { margin:0 0 4px; color:#fff; text-align:left; font-size:2.2rem; }
  .mid-banner p { margin:0; color:#f3f4f6; }

  .feature-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  .feature-card { background:#fafafa; border:1px solid #f1f5f9; padding:20px; text-align:center; transition:transform .22s ease, box-shadow .22s ease; }
  .feature-card:hover { transform:translateY(-3px); box-shadow:0 12px 24px rgba(15,23,42,.08); }
  .feature-card .icon { width:26px; height:26px; border-radius:6px; background:#f07179; color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:.8rem; margin-bottom:10px; }
  .feature-card h3 { margin:0 0 6px; font-size:1.5rem; }
  .feature-card p { margin:0; font-size:.84rem; }

  .about-split { display:grid; grid-template-columns:1fr 1fr; gap:18px; align-items:center; }
  .about-split h2 { text-align:left; margin-bottom:10px; }
  .about-image img { width:100%; display:block; border-radius:2px; }

  .factory { text-align:center; overflow:hidden; }
  .factory p { max-width:760px; margin:0 auto 12px; }
  .factory-marquee { margin-top:16px; display:grid; gap:10px; }
  .factory-row { display:flex; gap:8px; width:max-content; }
  .factory-row img { width:200px; aspect-ratio:4/3; object-fit:cover; display:block; flex:0 0 auto; transition:transform .2s ease, filter .2s ease; }
  .factory-row img:hover { transform:scale(1.03); filter:saturate(1.08); }
  .row-right { animation: moveRight 36s linear infinite; }
  .row-left { animation: moveLeft 36s linear infinite; }
  .factory-marquee:hover .row-right,
  .factory-marquee:hover .row-left { animation-play-state: paused; }

  .testimonials h2 { margin-bottom:14px; }
  .testimonial-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
  .testimonial { border:1px solid #f1f5f9; background:#fafafa; padding:16px; transition:transform .22s ease, box-shadow .22s ease; }
  .testimonial:hover { transform:translateY(-2px); box-shadow:0 10px 18px rgba(15,23,42,.08); }
  .testimonial-head { display:flex; align-items:center; gap:10px; margin-bottom:8px; }
  .testimonial-head img { width:42px; height:42px; border-radius:50%; object-fit:cover; flex:0 0 auto; }
  .testimonial h3 { margin:0 0 2px; font-size:1.05rem; }
  .testimonial span { font-size:.8rem; color:#64748b; }
  .testimonial p { margin:0; font-size:.86rem; }

  .head-row { display:flex; justify-content:space-between; align-items:flex-end; gap:18px; margin-bottom:12px; }
  .head-row h2 { text-align:left; margin:0 0 8px; }
  .head-row p { max-width:620px; margin:0; }
  .blog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  .blog-card { text-decoration:none; color:inherit; transition:transform .22s ease, box-shadow .22s ease; border:1px solid transparent; }
  .blog-card:hover { transform:translateY(-3px); box-shadow:0 12px 22px rgba(15,23,42,.1); border-color:#e5e7eb; }
  .blog-card img { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; }
  .meta-row { margin-top:6px; }
  .meta-row span { font-size:.72rem; color:#64748b; }
  .blog-card h3 { margin:6px 0 0; font-size:1.02rem; line-height:1.35; }

  @keyframes moveLeft {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @keyframes moveRight {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  @media (max-width: 980px) {
    .card-grid, .feature-grid, .blog-grid { grid-template-columns:repeat(2,1fr); }
    .about-split { grid-template-columns:1fr; }
    .factory-row img { width:180px; }
    .testimonial-grid { grid-template-columns:1fr; }
    .mid-banner-inner { flex-direction:column; align-items:flex-start; gap:10px; padding:18px 20px; }
  }

  @media (max-width: 640px) {
    .hero { min-height:420px; }
    .hero-inner {
      padding: 0 20px;
    }
    .hero-inner h1 {
      max-width: 100%;
      font-size: clamp(1.9rem, 8vw, 2.6rem);
    }
    .hero-inner p {
      max-width: 100%;
      font-size: 0.98rem;
    }
    .card-grid, .feature-grid, .blog-grid { grid-template-columns:1fr; }
    .factory-row img { width:150px; }
    .head-row { flex-direction:column; align-items:flex-start; }
    .mid-banner h2 { font-size:1.6rem; }
  }
</style>
