---
import {sanityClient} from 'sanity:client'
import MainLayout from '../../layouts/MainLayout.astro'
import ProductListing from '../../components/ProductListing.astro'
import type {ProductCard} from '../../components/ProductListing.astro'

type ProductRow = {
  title: string | null
  slug: string | null
  imageUrl: string | null
  imageAlt: string | null
  categoryName: string | null
  price: number | null
  updatedAt: string | null
}

type CategoryRow = {
  title: string | null
  slug: string | null
  count: number | null
}

const categories = await sanityClient.fetch<CategoryRow[]>(
  `*[_type == "productCategory"] | order(title asc) {
    title,
    "slug": slug.current,
    "count": count(*[_type=="product" && defined(slug.current) && references(^._id)])
  }`,
)

const productsRaw = await sanityClient.fetch<ProductRow[]>(
  `*[_type == "product" && defined(slug.current)] | order(_updatedAt desc) {
    title,
    "slug": slug.current,
    "imageUrl": mainImage.asset->url,
    "imageAlt": mainImage.alt,
    "categoryName": category->title,
    price,
    "updatedAt": _updatedAt
  }`,
)

const products: ProductCard[] = (productsRaw ?? [])
  .filter((p): p is ProductRow & {slug: string} => typeof p.slug === 'string' && p.slug.length > 0)
  .map((p) => ({
    title: p.title,
    slug: p.slug,
    imageUrl: p.imageUrl,
    imageAlt: p.imageAlt,
    categoryName: p.categoryName,
    price: p.price ?? null,
    updatedAt: p.updatedAt ?? null,
  }))

const scentTypes = [
  {
    title: 'Floral',
    description:
      'Infuse your brand and events with the fresh elegance of floral scents, creating a soft, inviting atmosphere.',
    image: '/products/types/floral.png',
  },
  {
    title: 'Fruity',
    description:
      'Sweet fruity fragrances deliver a fresh, delightful sensory experience for your gifts and events, leaving a lasting impression.',
    image: '/products/types/fruity.png',
  },
  {
    title: 'Woody',
    description:
      'Rich woody scents bring warmth and depth, adding a unique touch to your brand and seasonal promotions.',
    image: '/products/types/woody.png',
  },
  {
    title: 'Spicy',
    description:
      'Spicy scents ignite special moments, infusing your gifting and promotional events with bold character and energy.',
    image: '/products/types/spicy.png',
  },
  {
    title: 'Fresh',
    description:
      'Fresh aromas enhance your hospitality and events, offering a clean, invigorating experience for guests.',
    image: '/products/types/fresh.png',
  },
  {
    title: 'More scents',
    description:
      'Explore our range of custom scented candles, offering something unique and special for every occasion.',
    image: '/products/types/more-scents.png',
  },
]
---

<MainLayout
  title="Products | bike"
  description="Browse product catalogs with technical details, images, and inquiry-ready pages."
  seo={{canonicalUrl: '/products/'}}
>
  <style>
    .scent-types {
      max-width: 1140px;
      margin: 22px auto 38px;
      padding: 0 20px;
    }
    .scent-types h2 {
      margin: 0 0 22px;
      text-align: center;
      font-size: clamp(1.45rem, 2.7vw, 2rem);
      font-weight: 800;
      letter-spacing: -0.01em;
      color: #111827;
    }
    .scent-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
    .scent-card {
      border: 1px solid #e5e7eb;
      background: #fff;
      text-decoration: none;
      color: inherit;
      display: block;
      transition: box-shadow 0.2s ease, transform 0.2s ease;
    }
    .scent-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 22px rgba(15, 23, 42, 0.08);
    }
    .scent-card img {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      border-bottom: 1px solid #e5e7eb;
    }
    .scent-body {
      padding: 10px 10px 12px;
    }
    .scent-title {
      margin: 0 0 6px;
      font-size: 1.55rem;
      line-height: 1.08;
      font-weight: 700;
      color: #111827;
    }
    .scent-desc {
      margin: 0 0 8px;
      color: #4b5563;
      line-height: 1.55;
      font-size: 0.88rem;
      min-height: 56px;
    }
    .scent-link {
      color: #e85d6f;
      font-size: 0.86rem;
      font-weight: 700;
    }

    .page-hero {
      max-width: 1200px;
      margin: 0 auto;
      padding: 56px 20px 24px;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 28px;
      align-items: end;
    }
    .page-hero h1 {
      margin: 0 0 10px;
      font-size: clamp(1.85rem, 3.6vw, 2.7rem);
      letter-spacing: -0.02em;
      font-weight: 900;
      color: #111827;
      line-height: 1.12;
    }
    .page-hero p {
      margin: 0;
      color: #6b7280;
      font-size: 1.05rem;
      line-height: 1.7;
      max-width: 62ch;
    }
    .hero-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .stat {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 16px 18px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
    }
    .stat-label {
      color: #64748b;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 700;
      margin-bottom: 6px;
    }
    .stat-value {
      font-size: 1.55rem;
      font-weight: 900;
      color: #111827;
      line-height: 1.2;
    }
    .filter-row {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px 6px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 12px;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      background: #fff;
      color: #111827;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.9rem;
      transition: all 0.2s ease;
    }
    .chip:hover {
      border-color: color-mix(in srgb, var(--primary-color) 50%, #e5e7eb);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.06);
      transform: translateY(-1px);
    }
    .chip .count {
      font-weight: 800;
      color: #64748b;
      border-left: 1px solid #e5e7eb;
      padding-left: 8px;
    }
    @media (max-width: 900px) {
      .scent-grid {
        grid-template-columns: 1fr 1fr;
      }
      .page-hero {
        grid-template-columns: 1fr;
        gap: 14px;
        align-items: start;
      }
      .hero-stats {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 640px) {
      .scent-grid {
        grid-template-columns: 1fr;
      }
      .scent-title {
        font-size: 1.35rem;
      }
    }
  </style>

  <section class="scent-types">
    <h2>Types of scented candles</h2>
    <div class="scent-grid">
      {scentTypes.map((item) => (
        <a class="scent-card" href="/request-quote">
          <img src={item.image} alt={item.title} loading="lazy" />
          <div class="scent-body">
            <h3 class="scent-title">{item.title}</h3>
            <p class="scent-desc">{item.description}</p>
            <span class="scent-link">Get Fast Quote &gt;&gt;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="page-hero">
    <div>
      <h1>Products</h1>
      <p>
        Explore Car Light’s product range—built for automotive and heavy-duty applications. Click a
        category to browse, then open a product for specifications, images, and inquiry.
      </p>
    </div>
    <div class="hero-stats" aria-label="Product overview">
      <div class="stat">
        <div class="stat-label">Total Products</div>
        <div class="stat-value">{products.length}</div>
      </div>
      <div class="stat">
        <div class="stat-label">Categories</div>
        <div class="stat-value">{(categories ?? []).length}</div>
      </div>
    </div>
  </section>

  {(categories ?? []).length ? (
    <nav class="filter-row" aria-label="Browse by category">
      {(categories ?? [])
        .filter((c): c is CategoryRow & {slug: string} => typeof c.slug === 'string' && c.slug.length > 0)
        .map((c) => (
          <a class="chip" href={`/category/${c.slug}`}>
            <span>{c.title ?? 'Category'}</span>
            <span class="count">{c.count ?? 0}</span>
          </a>
        ))}
    </nav>
  ) : null}

  <ProductListing
    products={products}
    sectionTitle="All Products"
    sectionDescription="Professional-grade LED lighting products for B2B partners."
  />
</MainLayout>
