---
import MainLayout from '../layouts/MainLayout.astro'
import {sanityClient} from 'sanity:client'

const settings = await sanityClient.fetch<{companyName: string | null} | null>(
  `*[_type=="siteSettings"][0]{ companyName }`,
)
const brand = settings?.companyName?.trim() || 'MW Candle'
const pageTitle = `About Us | ${brand}`

const accent = '#e85d6f'
const heroImage = '/contact/hero-candles.png'
const teamImage = '/introduction/mw/team-group.png'
const founderImage = '/introduction/mw/founder.png'
const certificatesImage = '/introduction/mw/certificates.png'
const officeImages = [
  '/introduction/mw/office-1.png',
  '/introduction/mw/office-2.png',
  '/introduction/mw/office-3.png',
  '/introduction/mw/office-4.png',
  '/introduction/mw/office-5.png',
]
---

<MainLayout
  title={pageTitle}
  description={`Learn about ${brand}: our mission, team, factory, and commitment to quality scented candles and OEM/ODM partnerships.`}
  seo={{canonicalUrl: '/introduction/'}}
>
  <main class="about-page" style={`--about-accent: ${accent}`}>
    <section class="about-hero">
      <div class="about-hero-bg" style={`background-image: url('${heroImage}')`}></div>
      <div class="about-hero-overlay"></div>
      <div class="about-hero-inner">
        <h1>About Us</h1>
      </div>
    </section>

    <div class="about-wrap">
      <nav class="about-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">&gt;&gt;</span>
        <span class="current">About Us</span>
      </nav>

      <section class="about-welcome">
        <div class="about-welcome-copy">
          <h2>Welcome to {brand}</h2>
          <p>
            At <strong>{brand}</strong>, we don&apos;t just make candles—we create
            <strong>timeless, personalized experiences</strong> through scent, design, and craftsmanship.
            Our candles have become synonymous with <strong>luxury, sustainability, and elegance</strong>,
            providing high-quality, customizable solutions for a variety of businesses, from corporate gifting
            to event planning and home decor.
          </p>
          <h3 class="about-subhead">Our Mission</h3>
          <p>
            <strong
              >To enhance your world with bespoke candles that resonate with your brand, your style, and
              your values.</strong
            >
            Whether you&apos;re looking to leave a lasting impression at an event, create a personalized gift,
            or elevate your brand&apos;s identity, {brand} brings your vision to life with every flicker of
            light.
          </p>
        </div>
        <figure class="about-welcome-media">
          <img
            src={certificatesImage}
            alt={`${brand} certifications and test reports`}
            width="800"
            height="600"
            loading="eager"
          />
        </figure>
      </section>
    </div>

    <section class="about-partner">
      <div class="about-partner-inner">
        <div class="about-partner-left">
          <h2>Your Trusted Candle Manufacturing Partner</h2>
          <p>From boutique brands to global retailers—we scale to your needs.</p>
          <a href="/contact" class="about-btn">Contact Now</a>
        </div>
        <div class="about-stats" data-about-stats>
          <div class="about-stat">
            <span class="about-stat-num"><span class="about-stat-value" data-count-target="15">0</span>+</span>
            <span class="about-stat-label">Years of Expertise</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-num"><span class="about-stat-value" data-count-target="130">0</span>+</span>
            <span class="about-stat-label">Countries Served</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-num"><span class="about-stat-value" data-count-target="300">0</span>+</span>
            <span class="about-stat-label">Flexible Low-MOQ</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-num"><span class="about-stat-value" data-count-target="10">0</span>+</span>
            <span class="about-stat-label">Production Lines</span>
          </div>
        </div>
      </div>
    </section>

    <div class="about-wrap">
      <section class="about-company">
        <div class="about-company-head">
          <div>
            <h2>Company inside</h2>
            <p>
              Backed by a seasoned team of fragrance experts and candle artisans, we bring your OEM/ODM
              concepts to life with precision. From custom scents to bespoke packaging, every detail reflects
              our commitment to excellence.
            </p>
          </div>
          <div class="about-carousel-nav" role="group" aria-label="Gallery navigation">
            <button type="button" class="about-arrow" id="office-prev" aria-label="Previous images">
              ←
            </button>
            <button type="button" class="about-arrow" id="office-next" aria-label="Next images">→</button>
          </div>
        </div>
        <div class="about-carousel-viewport" id="office-viewport">
          <div class="about-carousel-track" id="office-track">
            {
              officeImages.map((src) => (
                <div class="about-carousel-slide">
                  <img src={src} alt="Office and production environment" loading="lazy" />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="about-founder">
        <h2 class="about-founder-title">Founder&apos;s Story</h2>
        <p class="about-founder-sub">15 years of experience in product development and market research</p>
        <div class="about-founder-card">
          <div class="about-founder-body">
            <img src={founderImage} alt="Founder" width="400" height="500" loading="lazy" />
            <div class="about-founder-text">
              <p>
                Over the past 15 years, we have assisted customers in more than 130 countries, partnering with
                retailers, hospitality brands, and distributors to launch and grow their candle and home
                fragrance programs—with rigorous quality control and responsive service at every step.
              </p>
              <p class="about-founder-name">Miss Wei</p>
              <p class="about-founder-role">CEO</p>
            </div>
          </div>
        </div>
      </section>

      <section class="about-quality">
        <figure class="about-quality-media">
          <a href={teamImage} target="_blank" rel="noopener noreferrer">
            <img src={teamImage} alt={`${brand} team`} loading="lazy" width="800" height="600" />
          </a>
        </figure>
        <div class="about-quality-copy">
          <h2>Our Commitment to Quality</h2>
          <p>
            Passed the ISO:9001 international quality management system and products have been approved by CE,
            GS, RoHS, LVD, LFGB, ETL. Strengthen your brand&apos;s credibility and attract more business
            partnerships, helping you stand out from other wholesalers.
          </p>
          <a href="/contact" class="about-btn">Contact Now</a>
        </div>
      </section>

      <section class="about-grow">
        <h2>Let&apos;s Grow Together</h2>
        <p>Welcome to establish long-term and mutually beneficial business relationships.</p>
        <div class="about-grow-actions">
          <a href="/contact" class="about-btn">Contact Us</a>
          <a href="/request-quote" class="about-btn about-btn-ghost">Get a Quote</a>
        </div>
      </section>
    </div>
  </main>

  <style>
    .about-page {
      background: var(--page-bg);
      color: #111;
      padding-bottom: 72px;
    }

    .about-hero {
      position: relative;
      min-height: clamp(220px, 32vw, 380px);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .about-hero-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
    }

    .about-hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(rgba(35, 24, 20, 0.5), rgba(35, 24, 20, 0.55));
    }

    .about-hero-inner {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: 48px 20px;
    }

    .about-hero-inner h1 {
      margin: 0;
      font-size: clamp(2rem, 5vw, 3.2rem);
      font-weight: 700;
      color: #fff;
      letter-spacing: 0.02em;
    }

    .about-wrap {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .about-crumb {
      padding: 16px 0 8px;
      font-size: 0.875rem;
      color: var(--about-accent);
      font-weight: 500;
    }

    .about-crumb a {
      color: var(--about-accent);
      text-decoration: none;
    }

    .about-crumb a:hover {
      text-decoration: underline;
    }

    .about-crumb .sep {
      margin: 0 8px;
    }

    .about-welcome {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(28px, 4vw, 48px);
      align-items: center;
      padding: 36px 0 56px;
    }

    .about-welcome-copy h2 {
      margin: 0 0 18px;
      font-size: clamp(1.5rem, 2.8vw, 2rem);
      font-weight: 700;
    }

    .about-welcome-copy p {
      margin: 0 0 16px;
      color: #333;
      line-height: 1.85;
      font-size: 0.98rem;
    }

    .about-welcome-copy p:last-child {
      margin-bottom: 0;
    }

    .about-subhead {
      margin: 22px 0 12px;
      font-size: 1.05rem;
      font-weight: 700;
    }

    .about-welcome-media {
      margin: 0;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
    }

    .about-welcome-media img {
      width: 100%;
      height: auto;
      display: block;
      vertical-align: middle;
    }

    .about-partner {
      background: #f5f5f5;
      padding: 48px 20px 56px;
      margin: 0 0 56px;
    }

    .about-partner-inner {
      max-width: 1140px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 28px;
      align-items: stretch;
    }

    .about-partner-left {
      background: #ebebeb;
      padding: 32px 28px;
      border-radius: 4px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .about-partner-left h2 {
      margin: 0 0 12px;
      font-size: clamp(1.35rem, 2.4vw, 1.75rem);
      font-weight: 700;
    }

    .about-partner-left p {
      margin: 0 0 22px;
      color: #444;
      line-height: 1.7;
      font-size: 0.95rem;
    }

    .about-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      align-self: flex-start;
      padding: 12px 28px;
      background: var(--about-accent);
      color: #fff !important;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.9rem;
      border: none;
      cursor: pointer;
      transition: filter 0.15s ease;
    }

    .about-btn:hover {
      filter: brightness(0.95);
    }

    .about-btn-ghost {
      background: #fff;
      color: #111 !important;
      border: 1px solid #ddd;
    }

    .about-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .about-stat {
      background: #ebebeb;
      padding: 24px 20px;
      border-radius: 4px;
      text-align: center;
    }

    .about-stat-num {
      display: block;
      font-size: 2rem;
      font-weight: 800;
      color: #111;
      margin-bottom: 8px;
      font-variant-numeric: tabular-nums;
    }

    .about-stat-value {
      display: inline-block;
      min-width: 2.2ch;
      text-align: right;
    }

    .about-stat-label {
      font-size: 0.88rem;
      color: #555;
      line-height: 1.4;
    }

    .about-company {
      margin-bottom: 56px;
    }

    .about-company-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 18px;
    }

    .about-company-head h2 {
      margin: 0 0 10px;
      font-size: clamp(1.4rem, 2.5vw, 1.85rem);
      font-weight: 700;
    }

    .about-company-head p {
      margin: 0;
      max-width: 720px;
      color: #444;
      line-height: 1.75;
      font-size: 0.95rem;
    }

    .about-carousel-nav {
      display: flex;
      gap: 10px;
      flex-shrink: 0;
    }

    .about-arrow {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid #ccc;
      background: #fff;
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      transition:
        background 0.15s ease,
        border-color 0.15s ease;
    }

    .about-arrow:hover {
      border-color: var(--about-accent);
      color: var(--about-accent);
    }

    .about-carousel-viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      margin: 0 -20px;
      padding: 0 20px 8px;
      -webkit-overflow-scrolling: touch;
    }

    .about-carousel-track {
      display: flex;
      gap: 12px;
    }

    .about-carousel-slide {
      flex: 0 0 calc(33.333% - 8px);
      min-width: min(320px, 85vw);
      scroll-snap-align: start;
    }

    .about-carousel-slide img {
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      display: block;
      border-radius: 4px;
    }

    .about-founder {
      text-align: center;
      margin-bottom: 56px;
    }

    .about-founder-title {
      margin: 0 0 8px;
      font-size: clamp(1.4rem, 2.5vw, 1.85rem);
      font-weight: 700;
    }

    .about-founder-sub {
      margin: 0 0 28px;
      color: #666;
      font-size: 0.95rem;
    }

    .about-founder-card {
      max-width: 1000px;
      margin: 0 auto;
      background: #f5f5f5;
      border-radius: 4px;
      overflow: hidden;
    }

    .about-founder-body {
      display: grid;
      grid-template-columns: minmax(200px, 38%) 1fr;
      gap: 0;
      text-align: left;
    }

    .about-founder-body img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      min-height: 280px;
    }

    .about-founder-text {
      padding: 28px 32px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .about-founder-text p {
      margin: 0 0 16px;
      color: #333;
      line-height: 1.8;
      font-size: 0.98rem;
    }

    .about-founder-name {
      margin: 8px 0 4px !important;
      font-weight: 800;
      font-size: 1.05rem !important;
    }

    .about-founder-role {
      margin: 0 !important;
      color: #666 !important;
      font-size: 0.9rem !important;
    }

    .about-quality {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 36px;
      align-items: center;
      margin-bottom: 56px;
    }

    .about-quality-copy h2 {
      margin: 0 0 14px;
      font-size: clamp(1.35rem, 2.4vw, 1.75rem);
      font-weight: 700;
    }

    .about-quality-copy p {
      margin: 0 0 22px;
      color: #444;
      line-height: 1.8;
      font-size: 0.95rem;
    }

    .about-quality-media {
      margin: 0;
    }

    .about-quality-media a {
      display: block;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
    }

    .about-quality-media img {
      width: 100%;
      height: auto;
      display: block;
      vertical-align: middle;
    }

    .about-grow {
      text-align: center;
      padding: 40px 20px 20px;
      border-top: 1px solid #eee;
    }

    .about-grow h2 {
      margin: 0 0 10px;
      font-size: clamp(1.35rem, 2.4vw, 1.75rem);
      font-weight: 700;
    }

    .about-grow p {
      margin: 0 0 22px;
      color: #555;
      font-size: 0.95rem;
    }

    .about-grow-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }

    @media (max-width: 900px) {
      .about-welcome,
      .about-partner-inner,
      .about-founder-body,
      .about-quality {
        grid-template-columns: 1fr;
      }

      .about-partner-inner {
        gap: 18px;
      }

      .about-carousel-slide {
        flex: 0 0 85%;
      }

    }
  </style>

  <script is:inline>
    ;(function () {
      var viewport = document.getElementById('office-viewport')
      var prev = document.getElementById('office-prev')
      var next = document.getElementById('office-next')
      if (!viewport || !prev || !next) return

      function step() {
        var slide = viewport.querySelector('.about-carousel-slide')
        if (!slide) return viewport.clientWidth * 0.5
        return slide.getBoundingClientRect().width + 12
      }

      prev.addEventListener('click', function () {
        viewport.scrollBy({left: -step(), behavior: 'smooth'})
      })
      next.addEventListener('click', function () {
        viewport.scrollBy({left: step(), behavior: 'smooth'})
      })
    })()
  </script>

  <script is:inline>
    ;(function () {
      var root = document.querySelector('[data-about-stats]')
      if (!root) return
      var els = root.querySelectorAll('[data-count-target]')
      if (!els.length) return

      function setFinal() {
        els.forEach(function (el) {
          var t = parseInt(el.getAttribute('data-count-target'), 10)
          if (!isNaN(t)) el.textContent = String(t)
        })
      }

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setFinal()
        return
      }

      var done = false
      function run() {
        if (done) return
        done = true
        var duration = 1650
        els.forEach(function (el, i) {
          var target = parseInt(el.getAttribute('data-count-target'), 10)
          if (isNaN(target)) return
          var delay = i * 110
          el.textContent = '0'
          window.setTimeout(function () {
            var start = performance.now()
            function frame(now) {
              var p = Math.min(1, (now - start) / duration)
              var eased = 1 - Math.pow(1 - p, 3)
              el.textContent = String(Math.round(target * eased))
              if (p < 1) requestAnimationFrame(frame)
              else el.textContent = String(target)
            }
            requestAnimationFrame(frame)
          }, delay)
        })
      }

      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                run()
                io.disconnect()
              }
            })
          },
          {threshold: 0.2, rootMargin: '0px 0px -10% 0px'},
        )
        io.observe(root)
      } else {
        run()
      }
    })()
  </script>
</MainLayout>
