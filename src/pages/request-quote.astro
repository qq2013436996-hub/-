---
import MainLayout from '../layouts/MainLayout.astro'
import {sanityClient} from 'sanity:client'

const url = new URL(Astro.request.url)
const product = url.searchParams.get('product') || ''
const settings = await sanityClient.fetch<{
  companyName: string | null
  contactEmail: string | null
  contactPhone: string | null
  companyAddress: string | null
} | null>(`*[_type=="siteSettings"][0]{
  companyName,
  contactEmail,
  contactPhone,
  companyAddress
}`)

const brand = settings?.companyName?.trim() || 'MW Candle'
const contactEmail = settings?.contactEmail?.trim() || 'lulu@mwcandle.com'
const contactPhone = settings?.contactPhone?.trim() || '+86 188 5210 0127'
const address =
  settings?.companyAddress?.trim() ||
  'Building 8, Phase I, No. 66, Yinshan Road, High-tech Industrial Development Zone Xuzhou City, China.'

const pageTitle = `Request a Quote | ${brand}`
const accent = '#d4586e'
---

<MainLayout
  title={pageTitle}
  description="Request a quote for custom scented candles, OEM/ODM, wholesale, and packaging."
  seo={{canonicalUrl: '/request-quote/'}}
>
  <div class="quote-mw-page">
    <section class="quote-mw-hero">
      <div class="quote-mw-hero-inner">
        <h1 class="quote-mw-hero-title">Request a Quote</h1>
      </div>
    </section>

    <div class="quote-mw-breadcrumb-wrap">
      <nav class="quote-mw-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">&gt;&gt;</span>
        <span class="current">Request a Quote</span>
      </nav>
    </div>

    <section class="quote-mw-intro">
      <h2>Get in Contact with {brand}</h2>
      <p>
        Share your product needs, quantities, and customization goals—our team typically replies within 24
        hours with practical options and next steps.
      </p>
    </section>

    <div class="quote-mw-columns">
      <aside class="quote-mw-aside">
        <h3>Contact Our Expert Team</h3>
        <ul class="quote-mw-info-list">
          <li>
            <span class="quote-mw-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
            </span>
            <div>
              <strong>Phone</strong>
              <a href={`tel:${contactPhone.replace(/\s/g, '')}`}>{contactPhone}</a>
            </div>
          </li>
          <li>
            <span class="quote-mw-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </span>
            <div>
              <strong>Email</strong>
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            </div>
          </li>
          <li>
            <span class="quote-mw-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <div>
              <strong>Address</strong>
              <span class="quote-mw-address">{address}</span>
            </div>
          </li>
        </ul>
      </aside>

      <div class="quote-mw-form-panel">
        <h2 class="quote-mw-form-heading">Send an Inquiry</h2>
        <p class="quote-mw-form-lead">
          Leave your details and requirements. We’ll follow up with options and quotation support.
        </p>
        <form id="quote-form" class="quote-mw-form">
          <div class="quote-mw-row2">
            <div class="quote-mw-field">
              <label for="name">Your Name <span class="rq-req">*</span></label>
              <input type="text" id="name" name="name" required placeholder="Full Name" />
            </div>
            <div class="quote-mw-field">
              <label for="email">Business Email <span class="rq-req">*</span></label>
              <input type="email" id="email" name="email" required placeholder="email@company.com" />
            </div>
          </div>
          <div class="quote-mw-row2">
            <div class="quote-mw-field">
              <label for="companyName">Company Name</label>
              <input type="text" id="companyName" name="companyName" placeholder="Your Company Name" />
            </div>
            <div class="quote-mw-field">
              <label for="country">Country</label>
              <input type="text" id="country" name="country" placeholder="e.g. Germany" />
            </div>
          </div>
          <div class="quote-mw-row2">
            <div class="quote-mw-field">
              <label for="phoneWhatsapp">Phone / WhatsApp</label>
              <input type="text" id="phoneWhatsapp" name="phoneWhatsapp" placeholder="+86 ..." />
            </div>
            <div class="quote-mw-field">
              <label for="buyerType">Buyer Type</label>
              <select id="buyerType" name="buyerType">
                <option value="">Please select</option>
                <option value="Distributor / Wholesaler">Distributor / Wholesaler</option>
                <option value="Brand Owner">Brand Owner</option>
                <option value="OEM / Manufacturer">OEM / Manufacturer</option>
                <option value="Retailer">Retailer</option>
                <option value="Personal Buyer">Personal Buyer</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
          <div class="quote-mw-row2">
            <div class="quote-mw-field">
              <label for="productInterestedIn">Product Interested In</label>
              <input
                type="text"
                id="productInterestedIn"
                name="productInterestedIn"
                value={product}
                placeholder="e.g., Scented candles"
              />
            </div>
            <div class="quote-mw-field">
              <label for="estimatedOrderQuantity">Estimated Order Quantity</label>
              <input
                type="text"
                id="estimatedOrderQuantity"
                name="estimatedOrderQuantity"
                placeholder="e.g., 1000 pcs"
              />
            </div>
          </div>
          <div class="quote-mw-field">
            <label for="subject">Inquiry Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              value={product ? `Inquiry about: ${product}` : ''}
              placeholder="e.g., Bulk order for custom jars"
            />
          </div>
          <div class="quote-mw-field">
            <label for="message">Your Requirements</label>
            <textarea
              id="message"
              name="message"
              placeholder="Please describe your needs, quantities, destination market, or customization..."
            ></textarea>
          </div>
          <input type="hidden" name="formType" value="request_quote" />
          <input type="hidden" name="firstSource" id="firstSource" />
          <input type="hidden" name="firstMedium" id="firstMedium" />
          <input type="hidden" name="firstCampaign" id="firstCampaign" />
          <input type="hidden" name="firstContent" id="firstContent" />
          <input type="hidden" name="firstTerm" id="firstTerm" />
          <input type="hidden" name="landingPage" id="landingPage" />
          <input type="hidden" name="currentPage" id="currentPage" />
          <input type="hidden" name="referrer" id="referrer" />
          <input type="hidden" name="gclid" id="gclid" />
          <input type="hidden" name="gbraid" id="gbraid" />
          <input type="hidden" name="wbraid" id="wbraid" />
          <input type="hidden" name="msclkid" id="msclkid" />
          <input type="hidden" name="fbclid" id="fbclid" />
          <input type="hidden" name="visitorPath" id="visitorPath" />
          <input type="hidden" name="submittedAt" id="submittedAt" />
          <button type="submit" class="quote-mw-submit">SUBMIT</button>
          <p class="quote-mw-note">We only use your info to respond to this inquiry.</p>
        </form>
        <div id="form-status" class="quote-mw-status" role="status" aria-live="polite"></div>
      </div>
    </div>
  </div>
</MainLayout>

<style define:vars={{accent}}>
  .quote-mw-page {
    --mw-accent: var(--accent);
    background: #fff;
    padding-bottom: 72px;
  }

  .quote-mw-hero {
    position: relative;
    min-height: clamp(200px, 28vw, 320px);
    background:
      linear-gradient(rgba(45, 28, 22, 0.45), rgba(45, 28, 22, 0.45)),
      url('/contact/hero-candles.png') center / cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quote-mw-hero-inner {
    padding: 48px 20px;
    text-align: center;
  }

  .quote-mw-hero-title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.1rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.02em;
    font-family:
      'Inter',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
  }

  .quote-mw-breadcrumb-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 14px 20px 0;
  }

  .quote-mw-breadcrumb {
    font-size: 0.875rem;
    color: var(--mw-accent);
    font-weight: 500;
  }

  .quote-mw-breadcrumb a {
    color: var(--mw-accent);
    text-decoration: none;
  }

  .quote-mw-breadcrumb a:hover {
    text-decoration: underline;
  }

  .quote-mw-breadcrumb .sep {
    margin: 0 8px;
    opacity: 0.85;
  }

  .quote-mw-intro {
    max-width: 900px;
    margin: 0 auto;
    padding: 28px 20px 36px;
    text-align: center;
  }

  .quote-mw-intro h2 {
    margin: 0 0 14px;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: #111;
  }

  .quote-mw-intro p {
    margin: 0;
    color: #6b7280;
    line-height: 1.75;
    font-size: 0.98rem;
  }

  .quote-mw-columns {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .quote-mw-aside h3 {
    margin: 0 0 22px;
    font-size: 1.2rem;
    font-weight: 700;
    color: #111;
  }

  .quote-mw-info-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .quote-mw-info-list li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .quote-mw-icon {
    flex-shrink: 0;
    color: #111;
    margin-top: 2px;
  }

  .quote-mw-info-list strong {
    display: block;
    font-size: 0.95rem;
    color: #111;
    margin-bottom: 6px;
  }

  .quote-mw-info-list a {
    color: var(--mw-accent);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .quote-mw-info-list a:hover {
    text-decoration: underline;
  }

  .quote-mw-address {
    display: block;
    color: #6b7280;
    font-size: 0.92rem;
    line-height: 1.65;
    max-width: 36ch;
  }

  .quote-mw-form-panel {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 28px 26px 32px;
    background: #fff;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
  }

  .quote-mw-form-heading {
    margin: 0 0 8px;
    font-size: 1.2rem;
    font-weight: 700;
    color: #111;
  }

  .quote-mw-form-lead {
    margin: 0 0 20px;
    color: #6b7280;
    font-size: 0.93rem;
    line-height: 1.65;
  }

  .quote-mw-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .quote-mw-row2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .quote-mw-field label {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: #111;
    margin-bottom: 7px;
  }

  .rq-req {
    color: var(--mw-accent);
  }

  .quote-mw-field input,
  .quote-mw-field textarea,
  .quote-mw-field select {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.15s ease;
  }

  .quote-mw-field input:focus,
  .quote-mw-field textarea:focus,
  .quote-mw-field select:focus {
    outline: none;
    border-color: var(--mw-accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--mw-accent) 35%, transparent);
  }

  .quote-mw-field textarea {
    min-height: 130px;
    resize: vertical;
  }

  .quote-mw-submit {
    align-self: flex-start;
    margin-top: 4px;
    padding: 12px 36px;
    background: var(--mw-accent);
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    cursor: pointer;
    text-transform: uppercase;
    transition: filter 0.15s ease;
  }

  .quote-mw-submit:hover:not(:disabled) {
    filter: brightness(0.95);
  }

  .quote-mw-submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .quote-mw-note {
    margin: 0;
    color: #94a3b8;
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .quote-mw-status {
    display: none;
    margin-top: 14px;
    padding: 12px 14px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .quote-mw-status.success {
    display: block;
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .quote-mw-status.error {
    display: block;
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  @media (max-width: 880px) {
    .quote-mw-columns {
      grid-template-columns: 1fr;
    }

    .quote-mw-row2 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  ;(function () {
    var form = document.getElementById('quote-form')
    var statusDiv = document.getElementById('form-status')
    var submitBtn = form && form.querySelector('.quote-mw-submit')
    if (!form || !statusDiv || !submitBtn) return

    function setHidden(id, value) {
      var el = document.getElementById(id)
      if (el && 'value' in el) el.value = value || ''
    }

    function updateAttributionFields() {
      var params = new URLSearchParams(window.location.search)
      var currentPage = window.location.pathname + window.location.search
      var storageKey = 'utm_first_touch_v1'
      var pathKey = 'visitor_path_v1'
      var stored = {}
      try {
        stored = JSON.parse(localStorage.getItem(storageKey) || '{}')
      } catch (_err) {}

      var firstSource = stored.firstSource || params.get('utm_source') || 'direct'
      var firstMedium = stored.firstMedium || params.get('utm_medium') || 'none'
      var firstCampaign = stored.firstCampaign || params.get('utm_campaign') || ''
      var firstContent = stored.firstContent || params.get('utm_content') || ''
      var firstTerm = stored.firstTerm || params.get('utm_term') || ''
      var landingPage = stored.landingPage || currentPage
      var firstReferrer = stored.referrer || document.referrer || ''
      var gclid = stored.gclid || params.get('gclid') || ''
      var gbraid = stored.gbraid || params.get('gbraid') || ''
      var wbraid = stored.wbraid || params.get('wbraid') || ''
      var msclkid = stored.msclkid || params.get('msclkid') || ''
      var fbclid = stored.fbclid || params.get('fbclid') || ''

      localStorage.setItem(
        storageKey,
        JSON.stringify({
          firstSource: firstSource,
          firstMedium: firstMedium,
          firstCampaign: firstCampaign,
          firstContent: firstContent,
          firstTerm: firstTerm,
          landingPage: landingPage,
          referrer: firstReferrer,
          gclid: gclid,
          gbraid: gbraid,
          wbraid: wbraid,
          msclkid: msclkid,
          fbclid: fbclid,
        }),
      )

      var previousPath = localStorage.getItem(pathKey) || ''
      var pathItems = previousPath ? previousPath.split(' > ') : []
      if (!pathItems.length || pathItems[pathItems.length - 1] !== currentPage) {
        pathItems.push(currentPage)
      }
      var visitorPath = pathItems.slice(-15).join(' > ')
      localStorage.setItem(pathKey, visitorPath)

      setHidden('firstSource', firstSource)
      setHidden('firstMedium', firstMedium)
      setHidden('firstCampaign', firstCampaign)
      setHidden('firstContent', firstContent)
      setHidden('firstTerm', firstTerm)
      setHidden('landingPage', landingPage)
      setHidden('currentPage', currentPage)
      setHidden('referrer', document.referrer || firstReferrer)
      setHidden('gclid', gclid)
      setHidden('gbraid', gbraid)
      setHidden('wbraid', wbraid)
      setHidden('msclkid', msclkid)
      setHidden('fbclid', fbclid)
      setHidden('visitorPath', visitorPath)
      setHidden('submittedAt', new Date().toISOString())
    }

    function showSuccess(msg) {
      statusDiv.textContent = msg
      statusDiv.style.display = 'block'
      statusDiv.className = 'quote-mw-status success'
    }

    function showError(msg) {
      statusDiv.textContent = msg
      statusDiv.style.display = 'block'
      statusDiv.className = 'quote-mw-status error'
    }

    updateAttributionFields()

    form.addEventListener('submit', async function (e) {
      e.preventDefault()
      updateAttributionFields()
      var originalLabel = submitBtn.textContent
      submitBtn.textContent = 'SENDING...'
      submitBtn.disabled = true
      statusDiv.style.display = 'none'

      var formData = new FormData(form)
      var data = Object.fromEntries(formData.entries())

      try {
        var response = await fetch('/api/submit-inquiry', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify(data),
        })
        var payload = await response.json().catch(function () {
          return {}
        })
        if (response.ok && payload.success) {
          showSuccess('Thank you! Your inquiry has been sent successfully. We will contact you soon.')
          form.reset()
          updateAttributionFields()
        } else {
          showError(payload.message || 'Something went wrong. Please try again later.')
        }
      } catch (_err) {
        showError('Oops! Something went wrong. Please try again later.')
      } finally {
        submitBtn.textContent = originalLabel || 'SUBMIT'
        submitBtn.disabled = false
      }
    })
  })()
</script>
