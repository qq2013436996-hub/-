---
import {sanityClient} from 'sanity:client'
import {PortableText} from 'astro-portabletext'
import type {TypedObject} from '@portabletext/types'
import MainLayout from '../../layouts/MainLayout.astro'
import {scentTypeCards} from '../../data/scentTypes'

type LinkRow = {title: string | null; slug: string | null}

type FeatureRow = {title: string | null; description: string | null; iconUrl: string | null}

type TestimonialRow = {
  quote: string | null
  clientName: string | null
  clientTitle: string | null
  companyName: string | null
  avatarUrl: string | null
}

export const prerender = false

const {slug} = Astro.params

/**
 * MW Corporate Gifting zigzag — image must match row copy (left/right alternates via `.is-reverse`):
 * 1 Stand Out: black/gold gift set + botanicals on wood → gift-01
 * 2 Build Stronger: hands opening white box with black jars → gift-03
 * 3 Celebrate: black satin box + lit black candle → gift-02
 */
const mwZigzagRowImages = [
  '/applications/mw/gift-01.png',
  '/applications/mw/gift-03.png',
  '/applications/mw/gift-02.png',
]

/**
 * MW “Benefits for Your Business” — four slides (left→right): 黑金礼盒场景 → 白盒开箱 → 黑缎带蜡烛 → 办公桌蜡烛礼盒
 */
const benefitStripImages = [
  '/applications/mw/benefit-mw-01.png',
  '/applications/mw/benefit-mw-02.png',
  '/applications/mw/benefit-mw-03.png',
  '/applications/mw/benefit-mw-04.png',
]

/** Application page testimonials always use portrait headshots (ignore wrong CMS avatars). */
const testimonialHeadshots = [
  '/applications/mw/client-adam.png',
  '/applications/mw/client-bennett.png',
  '/applications/mw/client-natalie.png',
]

const testimonialAvatarByName: Record<string, string> = {
  'adam smith': '/applications/mw/client-adam.png',
  'bennett f.': '/applications/mw/client-bennett.png',
  'bennett f': '/applications/mw/client-bennett.png',
  'natalie chen': '/applications/mw/client-natalie.png',
}

function resolveTestimonialHeadshot(clientName: string | null | undefined, index: number) {
  const key = (clientName ?? '').trim().toLowerCase().replace(/\s+/g, ' ')
  return testimonialAvatarByName[key] ?? testimonialHeadshots[index % testimonialHeadshots.length]
}

const WHY_CHOOSE_SIDE_IMAGE = '/applications/mw/office-building.png'

const defaultZigzag: FeatureRow[] = [
  {
    title: 'Stand Out with Unique Gifts',
    description:
      "Go beyond traditional gifts like pens or mugs and offer something truly memorable. A custom candle speaks volumes about your company's thoughtfulness and attention to detail.",
    iconUrl: null,
  },
  {
    title: 'Build Stronger Relationships',
    description:
      'Whether for clients, partners, or employees, receiving a personalized candle from your company will leave a lasting positive impression and foster stronger connections.',
    iconUrl: null,
  },
  {
    title: 'Celebrate Milestones & Achievements',
    description:
      'Candles are an elegant way to commemorate corporate milestones, holidays, and special events while giving employees and clients a meaningful token to cherish.',
    iconUrl: null,
  },
]

const defaultWhy: FeatureRow[] = [
  {
    title: 'Customizable for Any Occasion',
    description:
      'Tailored candles for client gifts, seasonal collections, product launches, and milestones.',
    iconUrl: null,
  },
  {
    title: 'Premium Quality',
    description:
      'Made with soy wax, beeswax, and essential oils for a clean, long-lasting burn and elegant design.',
    iconUrl: null,
  },
  {
    title: 'Eco-Friendly',
    description:
      "Sustainable waxes and recyclable packaging to reflect your company's environmental commitment.",
    iconUrl: null,
  },
  {
    title: 'Brand Customization',
    description:
      "Fully customizable fragrance, packaging, and labels to align with your brand's identity.",
    iconUrl: null,
  },
]

const fallbackTestimonials: TestimonialRow[] = [
  {
    quote: 'Their team made OEM straightforward — from wax samples to final carton artwork.',
    clientName: 'Adam Smith',
    clientTitle: 'OEM Candle Studio',
    companyName: '',
    avatarUrl: '/applications/mw/client-adam.png',
  },
  {
    quote:
      'We needed a polished gifting program fast — the candles and packaging looked incredible for our client event.',
    clientName: 'Bennett F.',
    clientTitle: 'Brand Purchasing',
    companyName: '',
    avatarUrl: '/applications/mw/client-bennett.png',
  },
  {
    quote: 'Quality is consistent batch to batch. Our shop customers always comment on the scent throw.',
    clientName: 'Natalie Chen',
    clientTitle: 'Gift Shop Owner',
    companyName: '',
    avatarUrl: '/applications/mw/client-natalie.png',
  },
]

const doc = await sanityClient.fetch<{
  title: string | null
  summary: string | null
  shortDescription: string | null
  heroImageUrl: string | null
  heroImageAlt: string | null
  content: TypedObject[] | null
  painPoints: FeatureRow[] | null
  solutionBenefits: FeatureRow[] | null
  installationScenarios: string[] | null
  cta: {title: string | null; description: string | null; buttonText: string | null; buttonUrl: string | null} | null
  recommendedProducts: LinkRow[] | null
  relatedCaseStudies: LinkRow[] | null
  relatedFaqs: Array<{question: string | null; answer: string | null}> | null
  relatedBlogs: LinkRow[] | null
  seo: {
    metaTitle: string | null
    metaDescription: string | null
    canonicalUrl: string | null
    ogTitle: string | null
    ogDescription: string | null
    ogImageUrl: string | null
    robots: string | null
  } | null
} | null>(
  `*[_type == "application" && slug.current == $slug][0]{
    title,
    summary,
    shortDescription,
    "heroImageUrl": heroImage.image.asset->url,
    "heroImageAlt": heroImage.alt,
    content,
    "painPoints": painPoints[]{title, description, "iconUrl": icon.asset->url},
    "solutionBenefits": solutionBenefits[]{title, description, "iconUrl": icon.asset->url},
    installationScenarios,
    "cta": cta{title, description, buttonText, buttonUrl},
    "recommendedProducts": recommendedProducts[]->{title, "slug": slug.current},
    "relatedCaseStudies": relatedCaseStudies[]->{title, "slug": slug.current},
    "relatedFaqs": relatedFaqs[]->{question, answer},
    "relatedBlogs": relatedBlogs[]->{title, "slug": slug.current},
    seo{
      metaTitle,
      metaDescription,
      canonicalUrl,
      ogTitle,
      ogDescription,
      "ogImageUrl": ogImage.asset->url,
      robots
    }
  }`,
  {slug},
)

const brand =
  (
    await sanityClient.fetch<{companyName: string | null}>(`*[_type == "siteSettings"][0]{companyName}`)
  )?.companyName?.trim() || 'MW Candle'

const testimonialRows = await sanityClient.fetch<TestimonialRow[]>(
  `*[_type == "testimonial"] | order(coalesce(displayOrder, 100) asc, _updatedAt desc)[0...8]{
    quote,
    clientName,
    clientTitle,
    companyName,
    "avatarUrl": avatar.asset->url
  }`,
)

if (!doc) {
  return Astro.redirect('/', 302)
}

const pageTitle = doc.seo?.metaTitle?.trim() || `${doc.title ?? 'Application'} | ${brand}`
const pageDescription =
  doc.seo?.metaDescription?.trim() ||
  doc.summary ||
  doc.shortDescription ||
  'Application scenarios for wholesale scented candles and custom gifting programs.'

const introH2 = doc.summary?.trim() || doc.title || 'Solutions for your brand'
const introP = doc.shortDescription?.trim() || ''

const zigSource = [...(doc.painPoints ?? []), ...(doc.solutionBenefits ?? [])].filter((r) => r.title)
const zigzagRows = (zigSource.length ? zigSource : defaultZigzag).map((row, i) => ({
  ...row,
  image: row.iconUrl || mwZigzagRowImages[i % mwZigzagRowImages.length],
}))

const whyRows = (doc.painPoints?.length ? doc.painPoints : defaultWhy).filter((r) => r.title)

const contactHref = doc.cta?.buttonUrl?.trim() || '/contact'
const contactLabel = doc.cta?.buttonText?.trim() || 'Contact'

const testimonialSource = (testimonialRows?.length ? testimonialRows : fallbackTestimonials).filter((t) => t.quote)

function testimonialMwOrder(name: string | null | undefined) {
  const n = (name ?? '').trim().toLowerCase()
  if (n.includes('adam') && n.includes('smith')) return 0
  if (n.includes('bennett')) return 1
  if (n.includes('natalie')) return 2
  return 50
}

testimonialSource.sort((a, b) => testimonialMwOrder(a.clientName) - testimonialMwOrder(b.clientName))

const testimonials = testimonialSource.map((t, i) => ({
  ...t,
  avatarUrl: resolveTestimonialHeadshot(t.clientName, i),
}))
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  seo={{
    canonicalUrl: doc.seo?.canonicalUrl || `/applications/${slug}/`,
    ogTitle: doc.seo?.ogTitle,
    ogDescription: doc.seo?.ogDescription,
    ogImage: doc.seo?.ogImageUrl || doc.heroImageUrl,
    robots: doc.seo?.robots?.trim() || 'index, follow',
  }}
>
  <div class="app-page">
    <section class="app-hero" aria-label={doc.title ?? 'Application'}>
      {doc.heroImageUrl ? (
        <img
          class="app-hero-bg"
          src={doc.heroImageUrl}
          alt={doc.heroImageAlt ?? doc.title ?? ''}
          width="1600"
          height="700"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="app-hero-fallback"></div>
      )}
      <div class="app-hero-overlay"></div>
      <div class="app-hero-inner">
        <h1>{doc.title}</h1>
      </div>
    </section>

    <nav class="app-crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">&gt;&gt;</span>
      <a href="/applications">Applications</a>
      <span class="sep">&gt;&gt;</span>
      <span class="here">{doc.title}</span>
    </nav>

    <section class="app-intro app-wrap">
      <h2>{introH2}</h2>
      {introP ? (
        introP.includes('**') ? (
          <p class="app-intro-copy" set:html={introP.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
        ) : (
          <p class="app-intro-copy">{introP}</p>
        )
      ) : null}
    </section>

    {
      doc.content?.length ? (
        <section class="app-rich app-wrap">
          <div class="app-prose">
            <PortableText value={doc.content} />
          </div>
        </section>
      ) : null
    }

    <section class="app-scents">
      <div class="app-scents-head app-wrap">
        <h2 class="app-scents-title">Explore scent directions</h2>
        <div class="app-strip-nav">
          <button type="button" class="app-round-btn app-scents-prev" aria-label="Scroll left">‹</button>
          <button type="button" class="app-round-btn app-scents-next" aria-label="Scroll right">›</button>
        </div>
      </div>
      <div class="app-scents-track-wrap app-wrap">
        <div class="app-scents-track" data-app-scents>
          {scentTypeCards.map((s) => (
            <article class="app-scent-card">
              <div class="app-scent-media">
                <img src={s.image} alt="" width="280" height="200" loading="lazy" />
              </div>
              <div class="app-scent-body">
                <h3>{s.title}</h3>
                <p>{s.description}</p>
                <a class="app-read-more" href="/request-quote">
                  Read More &gt;&gt;
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="app-zigzag">
      {
        zigzagRows.map((row, i) => (
          <div
            class:list={['app-zig-row', i % 2 === 1 && 'is-reverse']}
            data-reveal
            style={`--reveal-i:${i}`}
          >
            <div class="app-zig-media">
              <img src={row.image} alt="" width="640" height="480" loading="lazy" />
            </div>
            <div class="app-zig-copy">
              <h2>{row.title}</h2>
              {row.description ? <p>{row.description}</p> : null}
              <a class="btn-coral-solid" href={contactHref}>
                {contactLabel}
              </a>
            </div>
          </div>
        ))
      }
    </section>

    <section class="app-testimonials">
      <div class="app-wrap app-t-inner" data-reveal>
        <h2 class="app-t-title">What Our Clients Have to Say</h2>
        <p class="app-t-sub">Your trust is the greatest motivation</p>
        <div class="app-t-track-wrap">
          <div class="app-t-track" data-app-testimonials>
            {testimonials.map((t) => (
              <article class="app-t-card">
                {t.avatarUrl ? (
                  <img
                    class="app-t-avatar"
                    src={t.avatarUrl}
                    alt={t.clientName ? `Photo of ${t.clientName}` : ''}
                    width="72"
                    height="72"
                    loading="lazy"
                  />
                ) : (
                  <div class="app-t-avatar app-t-avatar-ph" aria-hidden="true" />
                )}
                <div class="app-t-right">
                  <p class="app-t-name">{t.clientName || 'Client'}</p>
                  <p class="app-t-role">
                    {[t.clientTitle, t.companyName].filter(Boolean).join(' · ')}
                  </p>
                  <p class="app-t-quote">“{t.quote}”</p>
                </div>
              </article>
            ))}
          </div>
        </div>
        <div class="app-t-dots" data-t-dots>
          {testimonials.map((_, i) => (
            <button type="button" class:list={['app-t-dot', i === 0 && 'is-on']} data-t-dot={i} aria-label={`Slide ${i + 1}`} />
          ))}
        </div>
      </div>
    </section>

    <section class="app-why app-wrap">
      <div class="app-why-grid">
        <div class="app-why-copy" data-reveal>
          <h2>Why Choose {brand} for Corporate Gifts?</h2>
          <ul class="app-check-list">
            {whyRows.map((row, idx) => (
              <li class="app-check-item" style={`--check-i:${idx}`}>
                <span class="app-check" aria-hidden="true">✓</span>
                <span>
                  <strong>{row.title}</strong>
                  {row.description ? ` ${row.description}` : ''}
                </span>
              </li>
            ))}
          </ul>
          <a class="btn-coral-solid" href="/request-quote">
            Get An Instant Quote
          </a>
        </div>
        <div class="app-why-media" data-reveal>
          <img
            src={WHY_CHOOSE_SIDE_IMAGE}
            alt=""
            width="640"
            height="480"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="app-benefits">
      <h2 class="app-benefits-title">Benefits for Your Business</h2>
      <div class="app-benefits-wrap app-wrap">
        <div class="app-benefits-track" data-app-benefits>
          {[...benefitStripImages, ...benefitStripImages].map((src) => (
            <div class="app-benefit-slide">
              <img src={src} alt="" width="360" height="260" loading="lazy" />
            </div>
          ))}
        </div>
        <div class="app-ben-scroll-track" aria-hidden="true">
          <div class="app-ben-scroll-thumb" data-ben-scroll-thumb />
        </div>
        <div class="app-benefits-nav">
          <button type="button" class="app-round-btn app-ben-prev" aria-label="Previous">‹</button>
          <button type="button" class="app-round-btn app-ben-next" aria-label="Next">›</button>
        </div>
      </div>
    </section>

    {
      (doc.recommendedProducts ?? []).filter((p) => p.slug).length ? (
        <section class="app-rec app-wrap">
          <h2>Recommended products</h2>
          <div class="app-rec-row">
            {(doc.recommendedProducts ?? []).map((item) =>
              item.slug ? (
                <a class="app-rec-pill" href={`/products/${item.slug}`}>
                  {item.title}
                </a>
              ) : null,
            )}
          </div>
        </section>
      ) : null
    }

    {
      (doc.relatedFaqs ?? []).some((f) => f.question) ? (
        <section class="app-faq-wrap app-wrap">
          <div class="app-faq-card" data-reveal>
            <h2 class="app-faq-h">FAQs</h2>
            <div class="app-faq-list">
              {(doc.relatedFaqs ?? []).map((item, idx) =>
                item.question ? (
                  <details class="app-faq-item">
                    <summary>
                      <span class="app-faq-n">{idx + 1}.</span>
                      <span class="app-faq-q">{item.question}</span>
                      <span class="app-faq-toggle" aria-hidden="true" />
                    </summary>
                    <div class="app-faq-a">
                      {item.answer ? <p>{item.answer}</p> : <a href="/faqs">View all FAQs</a>}
                    </div>
                  </details>
                ) : null,
              )}
            </div>
          </div>
        </section>
      ) : null
    }

    <section class="app-cta-band" aria-labelledby="app-cta-h">
      <h2 id="app-cta-h">Contact our specialist</h2>
      <p class="app-cta-sub">We're here to help you</p>
      <a href="/request-quote" class="btn-coral-solid">
        Get An Instant Quote
      </a>
    </section>
  </div>
</MainLayout>

<script is:inline>
  var scents = document.querySelector('[data-app-scents]')
  if (scents) {
    var p = document.querySelector('.app-scents-prev')
    var n = document.querySelector('.app-scents-next')
    if (p)
      p.addEventListener('click', function () {
        scents.scrollBy({left: -300, behavior: 'smooth'})
      })
    if (n)
      n.addEventListener('click', function () {
        scents.scrollBy({left: 300, behavior: 'smooth'})
      })
  }

  var ben = document.querySelector('[data-app-benefits]')
  var benThumb = document.querySelector('[data-ben-scroll-thumb]')
  function benSlideStep() {
    if (!ben) return 296
    var slide = ben.querySelector('.app-benefit-slide')
    if (!slide) return 296
    var st = getComputedStyle(ben)
    var gap = parseFloat(st.gap || st.columnGap || '16') || 16
    return slide.getBoundingClientRect().width + gap
  }
  function syncBenThumb() {
    if (!ben || !benThumb) return
    var total = ben.scrollWidth
    var view = ben.clientWidth
    var max = Math.max(0, total - view)
    var wPct = total > 0 ? Math.min(100, (view / total) * 100) : 100
    benThumb.style.width = wPct + '%'
    var leftPct = max <= 0 ? 0 : (ben.scrollLeft / max) * (100 - wPct)
    benThumb.style.left = leftPct + '%'
  }
  if (ben) {
    var benRoot = ben.parentElement
    var benPrev = benRoot && benRoot.querySelector('.app-ben-prev')
    var benNext = benRoot && benRoot.querySelector('.app-ben-next')
    var bStep = function () {
      return benSlideStep()
    }
    if (benPrev) benPrev.addEventListener('click', function () { ben.scrollBy({left: -bStep(), behavior: 'smooth'}) })
    if (benNext) benNext.addEventListener('click', function () { ben.scrollBy({left: bStep(), behavior: 'smooth'}) })
    ben.addEventListener('scroll', syncBenThumb)
    window.addEventListener('resize', syncBenThumb)
    syncBenThumb()
  }

  var tTrack = document.querySelector('[data-app-testimonials]')
  var dots = document.querySelectorAll('[data-t-dot]')
  function tSlideStep() {
    if (!tTrack) return 360
    var card = tTrack.querySelector('.app-t-card')
    if (!card) return tTrack.clientWidth || 360
    var st = getComputedStyle(tTrack)
    var gap = parseFloat(st.gap || st.columnGap || '16') || 16
    return card.getBoundingClientRect().width + gap
  }
  if (tTrack && dots.length) {
    function setDot(i) {
      dots.forEach(function (d, j) {
        d.classList.toggle('is-on', j === i)
      })
    }
    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        tTrack.scrollTo({left: i * tSlideStep(), behavior: 'smooth'})
        setDot(i)
      })
    })
    tTrack.addEventListener('scroll', function () {
      var step = tSlideStep() || 1
      var i = Math.round(tTrack.scrollLeft / step)
      setDot(Math.max(0, Math.min(i, dots.length - 1)))
    })
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var revealNodes = document.querySelectorAll('[data-reveal]')
    if (revealNodes.length) {
      var rio = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible')
              rio.unobserve(entry.target)
            }
          })
        },
        {threshold: 0.12, rootMargin: '0px 0px -6% 0px'},
      )
      revealNodes.forEach(function (el) {
        rio.observe(el)
      })
    }
  } else {
    document.querySelectorAll('[data-reveal]').forEach(function (el) {
      el.classList.add('is-visible')
    })
  }
</script>

<style>
  .app-page {
    background: #fff;
    color: #111827;
  }

  .app-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .app-hero {
    position: relative;
    min-height: min(52vw, 420px);
    max-height: 520px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .app-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .app-hero-bg {
      animation: appHeroKen 32s ease-in-out infinite alternate;
    }
  }

  @keyframes appHeroKen {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07);
    }
  }

  .app-hero-fallback {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #1e293b, #334155);
  }

  .app-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15, 23, 42, 0.65) 0%, rgba(15, 23, 42, 0.25) 100%);
  }

  .app-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
    padding: 48px 20px;
  }

  .app-hero-inner h1 {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.08;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.35);
  }

  .app-crumb {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 20px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .app-crumb a {
    color: #f07179;
    text-decoration: none;
  }

  .app-crumb a:hover {
    text-decoration: underline;
  }

  .app-crumb .sep {
    color: #f07179;
    opacity: 0.85;
  }

  .app-crumb .here {
    color: #64748b;
  }

  .app-intro {
    padding: 36px 20px 8px;
  }

  .app-intro h2 {
    margin: 0 0 14px;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .app-intro-copy {
    margin: 0;
    max-width: 72ch;
    color: #475569;
    line-height: 1.85;
    font-size: 1.02rem;
  }

  .app-rich {
    padding: 12px 20px 28px;
