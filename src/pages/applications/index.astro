---
import {sanityClient} from 'sanity:client'
import MainLayout from '../../layouts/MainLayout.astro'

type ApplicationRow = {
  title: string | null
  slug: string | null
  summary: string | null
  shortDescription: string | null
  imageUrl: string | null
  imageAlt: string | null
  recommendedCount: number | null
}

const companyName =
  (
    await sanityClient.fetch<{companyName: string | null}>(
      `*[_type == "siteSettings"][0]{companyName}`,
    )
  )?.companyName?.trim() || 'MW Candle'

const rows = await sanityClient.fetch<ApplicationRow[]>(
  `*[_type == "application" && defined(slug.current)] | order(_updatedAt desc){
    title,
    "slug": slug.current,
    summary,
    shortDescription,
    "imageUrl": heroImage.image.asset->url,
    "imageAlt": heroImage.alt,
    "recommendedCount": count(recommendedProducts)
  }`,
)

const items = (rows ?? []).filter((row): row is ApplicationRow & {slug: string} => Boolean(row.slug))
---

<MainLayout
  title={`Applications | ${companyName}`}
  description="Explore application scenarios and find recommended products for corporate gifting, events, and more."
  seo={{canonicalUrl: '/applications/'}}
>
  <main class="app-list-page">
    <div class="app-list-inner">
      <header class="app-list-head">
        <h1 class="app-list-title">Applications</h1>
        <p class="app-list-sub">
          Explore real use cases and discover how our candles and gift programs fit your brand—from
          <strong>corporate gifts</strong> to seasonal launches and client appreciation.
        </p>
      </header>

      {items.length ? (
        <ul class="app-list-grid">
          {items.map((item) => {
            const desc = item.shortDescription?.trim() || item.summary?.trim() || ''
            const excerpt =
              desc.length > 160 ? `${desc.slice(0, 157).trim()}…` : desc
            return (
              <li>
                <a class="app-list-card" href={`/applications/${item.slug}`}>
                  <div class="app-list-card-media">
                    {item.imageUrl ? (
                      <img
                        src={item.imageUrl}
                        alt={item.imageAlt ?? item.title ?? 'Application'}
                        loading="lazy"
                        width={400}
                        height={240}
                      />
                    ) : (
                      <div class="app-list-placeholder" aria-hidden="true" />
                    )}
                  </div>
                  <div class="app-list-card-body">
                    <h2 class="app-list-card-title">{item.title}</h2>
                    {excerpt ? <p class="app-list-card-desc">{excerpt}</p> : null}
                    <span class="app-list-readmore">Read More &gt;&gt;</span>
                  </div>
                </a>
              </li>
            )
          })}
        </ul>
      ) : (
        <p class="app-list-empty">No applications yet. Add and publish <code>application</code> documents in Sanity Studio.</p>
      )}
    </div>

    <section class="app-list-band" aria-labelledby="app-list-cta-heading">
      <div class="app-list-band-inner">
        <h2 id="app-list-cta-heading" class="app-list-band-title">Contact our specialist</h2>
        <p class="app-list-band-sub">We're here to help you</p>
        <a href="/request-quote" class="btn-coral-solid">Get An Instant Quote</a>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .app-list-page {
    background: #fff;
    color: #111;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }
  .app-list-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 20px 64px;
  }
  .app-list-head {
    max-width: 720px;
    margin-bottom: 40px;
  }
  .app-list-title {
    margin: 0 0 16px;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .app-list-sub {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.75;
    color: #444;
  }
  .app-list-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .app-list-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background: #f7f7f7;
    border-radius: 4px;
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .app-list-card:hover {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }
  .app-list-card:focus-visible {
    outline: 2px solid #ff5a43;
    outline-offset: 2px;
  }
  .app-list-card-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #eee;
  }
  .app-list-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .app-list-placeholder {
    width: 100%;
    height: 100%;
    min-height: 160px;
    background: linear-gradient(145deg, #ececec 0%, #ddd 100%);
  }
  .app-list-card-body {
    padding: 18px 18px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }
  .app-list-card-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .app-list-card-desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #555;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .app-list-readmore {
    margin-top: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #ff5a43;
  }
  .app-list-card:hover .app-list-readmore {
    text-decoration: underline;
  }
  .app-list-empty {
    margin: 0;
    padding: 24px;
    background: #f7f7f7;
    border-radius: 8px;
    color: #64748b;
  }
  .app-list-band {
    background: #ffd4ce;
    padding: 48px 20px 56px;
  }
  .app-list-band-inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  .app-list-band-title {
    margin: 0 0 8px;
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 700;
  }
  .app-list-band-sub {
    margin: 0 0 24px;
    font-size: 1rem;
    color: #333;
  }
</style>
