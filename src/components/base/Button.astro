---
interface Props {
  href?: string
  type?: 'button' | 'submit' | 'reset'
  variant?: 'primary' | 'secondary'
}
const {href, type = 'button', variant = 'primary'} = Astro.props as Props
---

{
  href ? (
    <a class={`btn ${variant}`} href={href}><slot /></a>
  ) : (
    <button class={`btn ${variant}`} type={type}><slot /></button>
  )
}

<style>
  .btn { display: inline-flex; padding: 10px 16px; border-radius: 8px; font-weight: 700; text-decoration: none; border: 1px solid transparent; cursor: pointer; }
  .btn.primary { background: var(--primary-color, #ff6600); color: #fff; }
  .btn.secondary { background: #fff; color: #111827; border-color: #e5e7eb; }
</style>
