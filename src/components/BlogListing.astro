---
import {BLOG_PAGE_SIZE, type BlogRow} from '../lib/blogPosts'

type Props = {
  posts: (BlogRow & {slug: string})[]
  currentPage: number
  totalPages: number
}

const {posts, currentPage, totalPages} = Astro.props as Props

const hrefForPage = (p: number) => (p <= 1 ? '/blog/' : `/blog/page/${p}/`)

const tiles = posts.slice(0, BLOG_PAGE_SIZE)
const has4 = tiles.length === 4
const has3 = tiles.length === 3
const has2 = tiles.length === 2
const has1 = tiles.length === 1

const gridClass = has4 ? 'is-four' : has3 ? 'is-three' : has2 ? 'is-two' : has1 ? 'is-one' : ''
---

<section class:list={['blog-mw-grid', gridClass]} aria-label="Blog posts">
  {
    tiles[0] ? (
      <a class="tile tile-main" href={`/blog/${tiles[0].slug}`} data-blog-tile style="--i:0">
        {tiles[0].imageUrl ? (
          <img src={tiles[0].imageUrl} alt={tiles[0].imageAlt ?? tiles[0].title ?? ''} loading="eager" width="640" height="400" />
        ) : (
          <div class="tile-ph" aria-hidden="true" />
        )}
        <div class="tile-scrim" aria-hidden="true" />
        <div class="tile-copy">
          <h2>{tiles[0].title}</h2>
          {tiles[0].excerpt ? <p>{tiles[0].excerpt}</p> : null}
        </div>
      </a>
    ) : null
  }
  {
    tiles[1] ? (
      <a class="tile tile-tall" href={`/blog/${tiles[1].slug}`} data-blog-tile style="--i:1">
        {tiles[1].imageUrl ? (
          <img src={tiles[1].imageUrl} alt={tiles[1].imageAlt ?? tiles[1].title ?? ''} loading="eager" width="400" height="520" />
        ) : (
          <div class="tile-ph" aria-hidden="true" />
        )}
        <div class="tile-scrim" aria-hidden="true" />
        <div class="tile-copy">
          <h2>{tiles[1].title}</h2>
          {tiles[1].excerpt ? <p>{tiles[1].excerpt}</p> : null}
        </div>
      </a>
    ) : null
  }
  {
    tiles[2] ? (
      <a class="tile tile-small-left" href={`/blog/${tiles[2].slug}`} data-blog-tile style="--i:2">
        {tiles[2].imageUrl ? (
          <img src={tiles[2].imageUrl} alt={tiles[2].imageAlt ?? tiles[2].title ?? ''} loading="lazy" width="400" height="240" />
        ) : (
          <div class="tile-ph" aria-hidden="true" />
        )}
        <div class="tile-scrim" aria-hidden="true" />
        <div class="tile-copy">
          <h2>{tiles[2].title}</h2>
          {tiles[2].excerpt ? <p>{tiles[2].excerpt}</p> : null}
        </div>
      </a>
    ) : null
  }
  {
    tiles[3] ? (
      <a class="tile tile-small-right" href={`/blog/${tiles[3].slug}`} data-blog-tile style="--i:3">
        {tiles[3].imageUrl ? (
          <img src={tiles[3].imageUrl} alt={tiles[3].imageAlt ?? tiles[3].title ?? ''} loading="lazy" width="400" height="240" />
        ) : (
          <div class="tile-ph" aria-hidden="true" />
        )}
        <div class="tile-scrim" aria-hidden="true" />
        <div class="tile-copy">
          <h2>{tiles[3].title}</h2>
          {tiles[3].excerpt ? <p>{tiles[3].excerpt}</p> : null}
        </div>
      </a>
    ) : null
  }
</section>

{
  totalPages > 1 ? (
    <nav class="blog-pager" aria-label="Pagination">
      {currentPage > 1 ? (
        <a class="blog-pager-prev" href={hrefForPage(currentPage - 1)} aria-label="Previous page">
          ←
        </a>
      ) : (
        <span class="blog-pager-prev is-disabled" aria-hidden="true">
          ←
        </span>
      )}
      {Array.from({length: totalPages}, (_, j) => {
        const p = j + 1
        return p === currentPage ? (
          <span class="blog-pager-link is-current" aria-current="page">
            {p}
          </span>
        ) : (
          <a class="blog-pager-link" href={hrefForPage(p)}>
            {p}
          </a>
        )
      })}
      {currentPage < totalPages ? (
        <a class="blog-pager-next" href={hrefForPage(currentPage + 1)} aria-label="Next page">
          →
        </a>
      ) : (
        <span class="blog-pager-next is-disabled" aria-hidden="true">
          →
        </span>
      )}
    </nav>
  ) : null
}

<script is:inline>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var tiles = document.querySelectorAll('[data-blog-tile]')
    if (tiles.length && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in')
              io.unobserve(e.target)
            }
          })
        },
        {threshold: 0.06, rootMargin: '0px 0px -6% 0px'},
      )
      tiles.forEach(function (t) {
        io.observe(t)
      })
    }
  } else {
    document.querySelectorAll('[data-blog-tile]').forEach(function (t) {
      t.classList.add('is-in')
    })
  }
</script>

<style>
  .blog-mw-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: minmax(220px, 260px) minmax(170px, 200px);
    gap: 12px;
    margin-bottom: 28px;
  }

  .blog-mw-grid.is-one {
    grid-template-columns: 1fr;
    grid-template-rows: minmax(280px, 360px);
  }

  .blog-mw-grid.is-one .tile-main {
    grid-column: 1;
    grid-row: 1;
  }

  .blog-mw-grid.is-two {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: minmax(260px, 320px);
  }

  .blog-mw-grid.is-two .tile-main {
    grid-column: 1;
    grid-row: 1;
  }

  .blog-mw-grid.is-two .tile-tall {
    grid-column: 2;
    grid-row: 1;
  }

  .blog-mw-grid.is-three {
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: minmax(220px, 260px) minmax(170px, 200px);
  }

  .blog-mw-grid.is-three .tile-main {
    grid-column: 1 / span 2;
    grid-row: 1;
  }

  .blog-mw-grid.is-three .tile-tall {
    grid-column: 3;
    grid-row: 1 / span 2;
  }

  .blog-mw-grid.is-three .tile-small-left {
    grid-column: 1;
    grid-row: 2;
  }

  .blog-mw-grid.is-three .tile-small-right {
    display: none;
  }

  .tile {
    position: relative;
    display: block;
    text-decoration: none;
    color: #fff;
    border-radius: 2px;
    overflow: hidden;
    background: #1e293b;
    min-height: 0;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.1);
    transition:
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile[data-blog-tile] {
      opacity: 0;
      transform: translateY(18px);
    }
    .tile[data-blog-tile].is-in {
      opacity: 1;
      transform: translateY(0);
      transition:
        opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.35s ease;
      transition-delay: calc(var(--i, 0) * 0.08s);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile[data-blog-tile] {
      opacity: 1;
      transform: none;
    }
  }

  .tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile:hover {
      transform: none;
    }
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tile:hover img {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile:hover img {
      transform: none;
    }
  }

  .tile-ph {
    width: 100%;
    height: 100%;
    min-height: 160px;
    background: linear-gradient(145deg, #334155, #1e293b);
  }

  .tile-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.06) 0%, rgba(0, 0, 0, 0.72) 100%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .tile:hover .tile-scrim {
    opacity: 0.95;
  }

  .tile-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 14px 12px 12px;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tile:hover .tile-copy {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile:hover .tile-copy {
      transform: none;
    }
  }

  .tile-copy h2 {
    margin: 0 0 6px;
    font-size: 1.45rem;
    line-height: 1.18;
    font-weight: 700;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tile-small-left .tile-copy h2,
  .tile-small-right .tile-copy h2,
  .tile-tall .tile-copy h2 {
    font-size: 1.02rem;
  }

  .tile-copy p {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-mw-grid.is-four .tile-main {
    grid-column: 1 / span 2;
    grid-row: 1;
  }

  .blog-mw-grid.is-four .tile-tall {
    grid-column: 3;
    grid-row: 1 / span 2;
  }

  .blog-mw-grid.is-four .tile-small-left {
    grid-column: 1;
    grid-row: 2;
  }

  .blog-mw-grid.is-four .tile-small-right {
    grid-column: 2;
    grid-row: 2;
  }

  .blog-pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 14px;
    padding: 8px 0 4px;
  }

  .blog-pager-prev {
    margin-right: 6px;
    font-size: 1.1rem;
    font-weight: 700;
    color: #e85d6f;
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 4px;
    transition: background 0.2s ease;
  }

  .blog-pager-prev:hover {
    background: rgba(232, 93, 111, 0.12);
  }

  .blog-pager-prev.is-disabled {
    color: #cbd5e1;
    pointer-events: none;
  }

  .blog-pager-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 8px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #e85d6f;
    text-decoration: none;
    border-radius: 4px;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .blog-pager-link:hover {
    background: rgba(232, 93, 111, 0.12);
  }

  .blog-pager-link.is-current {
    color: #0f172a;
    background: #f1f5f9;
    cursor: default;
  }

  .blog-pager-next {
    margin-left: 6px;
    font-size: 1.1rem;
    font-weight: 700;
    color: #e85d6f;
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 4px;
    transition: background 0.2s ease;
  }

  .blog-pager-next:hover {
    background: rgba(232, 93, 111, 0.12);
  }

  .blog-pager-next.is-disabled {
    color: #cbd5e1;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .blog-mw-grid.is-four {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 220px 200px 200px;
    }

    .blog-mw-grid.is-four .tile-main {
      grid-column: 1 / span 2;
      grid-row: 1;
    }

    .blog-mw-grid.is-four .tile-tall {
      grid-column: 2;
      grid-row: 2 / span 2;
    }

    .blog-mw-grid.is-four .tile-small-left {
      grid-column: 1;
      grid-row: 2;
    }

    .blog-mw-grid.is-four .tile-small-right {
      grid-column: 1;
      grid-row: 3;
    }
  }

  @media (max-width: 560px) {
    .blog-mw-grid,
    .blog-mw-grid.is-four,
    .blog-mw-grid.is-three {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(4, minmax(200px, 240px));
    }

    .blog-mw-grid.is-four .tile-main,
    .blog-mw-grid.is-four .tile-tall,
    .blog-mw-grid.is-four .tile-small-left,
    .blog-mw-grid.is-four .tile-small-right,
    .blog-mw-grid.is-three .tile-main,
    .blog-mw-grid.is-three .tile-tall,
    .blog-mw-grid.is-three .tile-small-left {
      grid-column: 1;
      grid-row: auto;
    }

    .blog-mw-grid.is-three .tile-small-right {
      display: none;
    }
  }
</style>
