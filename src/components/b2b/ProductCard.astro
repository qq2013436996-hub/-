---
interface Props {
  title: string
  href: string
  imageUrl?: string
  priceText?: string
}
const {title, href, imageUrl, priceText = 'Contact for Price'} = Astro.props as Props
---
<a class="product-card" href={href}>
  {imageUrl ? <img src={imageUrl} alt={title} loading="lazy" /> : null}
  <h3>{title}</h3>
  <p>{priceText}</p>
</a>
<style>
  .product-card { display:block; border: 1px solid #e5e7eb; border-radius: 12px; padding: 12px; text-decoration:none; color:inherit; background:#fff; }
  img { width: 100%; height: 180px; object-fit: contain; margin-bottom: 10px; }
  h3 { margin: 0 0 6px; font-size: 1rem; } p { margin: 0; color: #64748b; font-weight: 700; }
</style>
