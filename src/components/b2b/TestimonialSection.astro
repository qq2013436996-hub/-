---
type Item = {quote: string; author?: string}
interface Props { testimonials: Item[] }
const {testimonials} = Astro.props as Props
---
<section>
  <h2>Testimonials</h2>
  <div class="list">
    {testimonials.map((t) => (
      <blockquote>
        <p>"{t.quote}"</p>
        {t.author ? <cite>{t.author}</cite> : null}
      </blockquote>
    ))}
  </div>
</section>
<style>
  .list { display:grid; gap:10px; }
  blockquote { margin:0; border:1px solid #e5e7eb; border-radius:10px; padding:12px; background:#fff; }
  p { margin:0 0 6px; color:#334155; } cite { color:#64748b; font-size:0.9rem; }
</style>
